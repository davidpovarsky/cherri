debugTraceEvent(stage: "before", label: "export-build-only")
// Same Unicode payload and export options as the historical failed probe.
let original = text("quote \" backslash \\ newline\nHebrew שָׁלוֹם cherry 🍒 token SYNTHETIC_SECRET")
