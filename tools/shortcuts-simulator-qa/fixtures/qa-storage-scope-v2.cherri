shortcut "qa-storage-scope-v2" {
    version: "27"
}
comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent("before", "scope")
let globalValue = text("P15_STORAGE_GLOBAL")
let localValue = text("P15_STORAGE_LOCAL")
var globalTypeFlag = "GLOBAL_TYPE_OK"
var globalValueFlag = "GLOBAL_VALUE_OK"
var localTypeFlag = "LOCAL_TYPE_OK"
var localValueFlag = "LOCAL_VALUE_OK"
storeValue("cherri.qa.p15.storage.scope.35a6b60", globalValue, true)
storeValue("cherri.qa.p15.storage.scope.35a6b60", localValue, false)
let globalRead = getStoredValue("cherri.qa.p15.storage.scope.35a6b60", true)
let localRead = getStoredValue("cherri.qa.p15.storage.scope.35a6b60", false)
let textType = typeOf(globalValue)
let globalType = typeOf(globalRead)
let localType = typeOf(localRead)
if globalType != textType { globalTypeFlag = "GLOBAL_TYPE_FAIL" }
if globalRead != globalValue { globalValueFlag = "GLOBAL_VALUE_FAIL" }
if localType != textType { localTypeFlag = "LOCAL_TYPE_FAIL" }
if localRead != localValue { localValueFlag = "LOCAL_VALUE_FAIL" }
deleteStoredValue("cherri.qa.p15.storage.scope.35a6b60", true)
deleteStoredValue("cherri.qa.p15.storage.scope.35a6b60", false)
let verdict = text(f"{globalTypeFlag}:{globalValueFlag}:{localTypeFlag}:{localValueFlag}")
comment("ANCHOR_CARD_15_MID_CENTER")
debugTraceEvent("after", "scope")
let traceEnvelope = debugExportTrace("qa-storage-scope-v2")
let finalSummary = text(f"CHERRI_QA_STORAGE_SCOPE_RESULT:{verdict}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
