comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent(stage: "before", label: "raw-grouping")
var verdict = "P15_LABEL_RAW_GROUPING_OK"
let first = ["first", "second"]
let firstLog = debugLog()
let firstCount = count(firstLog)
let second = text("third")
let secondLog = debugLog()
let secondCount = count(secondLog)
if firstCount != 2 { verdict = "P15_LABEL_RAW_FIRST_COUNT" }
if secondCount != 3 { verdict = "P15_LABEL_RAW_SECOND_COUNT" }
comment("ANCHOR_CARD_15_MID_CENTER")
debugTraceEvent(stage: "after", label: "raw-grouping")
let traceEnvelope = debugExportTrace(runId: "qa-label-raw-grouping-v2")
let finalSummary = text(f"CHERRI_QA_LABEL_PROBE_RESULT:{verdict}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
