comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent("before", "setname-alias")
@verdict = "P15_LABEL_SETNAME_ISOLATED_OK"
const original = base64Decode("AQIDBA==")
const originalType = typeOf(original)
const originalName = getName(original)
const originalBytes = base64Encode(original, "None")
const renamed = setName(original, "p15-label-????-??.bin")
const renamedType = typeOf(renamed)
const renamedName = getName(renamed)
const renamedBytes = base64Encode(renamed, "None")
const originalNameAfter = getName(original)
const originalBytesAfter = base64Encode(original, "None")
if renamedType != originalType { @verdict = "P15_LABEL_SETNAME_TYPE_FAIL" }
if renamedName != "p15-label-????-??.bin" { @verdict = "P15_LABEL_SETNAME_LABEL_FAIL" }
if renamedBytes != originalBytes { @verdict = "P15_LABEL_SETNAME_BYTES_FAIL" }
if originalNameAfter != originalName { @verdict = "P15_LABEL_SETNAME_ALIASED_NAME" }
if originalBytesAfter != originalBytes { @verdict = "P15_LABEL_SETNAME_SOURCE_MUTATED" }
comment("ANCHOR_CARD_15_MID_CENTER")
debugTraceEvent("after", "setname-alias")
const traceEnvelope = debugExportTrace("qa-label-setname-alias-legacy")
const finalSummary = text("CHERRI_QA_LABEL_PROBE_RESULT:{verdict}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
