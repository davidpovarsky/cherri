comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent(stage: "before", label: "setname-alias")
var verdict = "P15_LABEL_SETNAME_ISOLATED_OK"
let original = base64Decode("AQIDBA==")
let originalType = typeOf(original)
let originalName = getName(original)
let originalBytes = base64Encode(original, lineBreakMode: "None")
let renamed = setName(original, "p15-label-שלום-🍒.bin")
let renamedType = typeOf(renamed)
let renamedName = getName(renamed)
let renamedBytes = base64Encode(renamed, lineBreakMode: "None")
let originalNameAfter = getName(original)
let originalBytesAfter = base64Encode(original, lineBreakMode: "None")
if renamedType != originalType { verdict = "P15_LABEL_SETNAME_TYPE_FAIL" }
if renamedName != "p15-label-שלום-🍒.bin" { verdict = "P15_LABEL_SETNAME_LABEL_FAIL" }
if renamedBytes != originalBytes { verdict = "P15_LABEL_SETNAME_BYTES_FAIL" }
if originalNameAfter != originalName { verdict = "P15_LABEL_SETNAME_ALIASED_NAME" }
if originalBytesAfter != originalBytes { verdict = "P15_LABEL_SETNAME_SOURCE_MUTATED" }
comment("ANCHOR_CARD_15_MID_CENTER")
debugTraceEvent(stage: "after", label: "setname-alias")
let traceEnvelope = debugExportTrace(runId: "qa-label-setname-alias-v2")
let finalSummary = text(f"CHERRI_QA_LABEL_PROBE_RESULT:{verdict}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
