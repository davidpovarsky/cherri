comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent(stage: "before", label: "file-carrier")
var verdict = "P15_LABEL_FILE_CARRIER_OK"
let original = base64Decode("AQIDBA==")
let originalType = typeOf(original)
let originalBytes = base64Encode(original, lineBreakMode: "None")
let transported = getVariable(original)
let envelope = {"label": "תווית \"🍒\""}
let record = setValue(envelope, "payload", transported)
let restoredLabel = getValue(record, "label")
if restoredLabel != "תווית \"🍒\"" { verdict = "P15_LABEL_METADATA_FAIL" }
let restored = getValue(record, "payload")
let restoredType = typeOf(restored)
let restoredBytes = base64Encode(restored, lineBreakMode: "None")
let originalBytesAfter = base64Encode(original, lineBreakMode: "None")
if originalBytes != "AQIDBA==" { verdict = "P15_LABEL_FILE_BASELINE_FAIL" }
if restoredType != originalType { verdict = "P15_LABEL_FILE_TYPE_FAIL" }
if restoredBytes != originalBytes { verdict = "P15_LABEL_FILE_BYTES_FAIL" }
if originalBytesAfter != originalBytes { verdict = "P15_LABEL_FILE_SOURCE_MUTATED" }
comment("ANCHOR_CARD_15_MID_CENTER")
debugTraceEvent(stage: "after", label: "file-carrier")
let traceEnvelope = debugExportTrace(runId: "qa-label-file-carrier-v2")
let finalSummary = text(f"CHERRI_QA_LABEL_PROBE_RESULT:{verdict}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
