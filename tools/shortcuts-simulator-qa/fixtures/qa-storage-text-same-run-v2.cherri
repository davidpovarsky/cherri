shortcut "qa-storage-text-same-run-v2" {
    version: "27"
}
comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent("before", "text-same-run")
let original = text("P15_STORAGE_VALUE: שָׁלוֹם 🍒 quote\" slash\\ newline\n")
var typeFlag = "TYPE_OK"
var valueFlag = "VALUE_OK"
storeValue("cherri.qa.p15.storage.text.35a6b60", original, true)
let restored = getStoredValue("cherri.qa.p15.storage.text.35a6b60", true)
let expectedType = typeOf(original)
let actualType = typeOf(restored)
if actualType != expectedType { typeFlag = "TYPE_FAIL" }
if restored != original { valueFlag = "VALUE_FAIL" }
deleteStoredValue("cherri.qa.p15.storage.text.35a6b60", true)
let verdict = text(f"{typeFlag}:{valueFlag}")
comment("ANCHOR_CARD_15_MID_CENTER")
debugTraceEvent("after", "text-same-run")
let traceEnvelope = debugExportTrace("qa-storage-text-same-run-v2")
let finalSummary = text(f"CHERRI_QA_STORAGE_TEXT_RESULT:{verdict}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
