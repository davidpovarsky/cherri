comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent(stage: "before", label: "f01-diag-predicate")
// Synthetic isolation probe. Its success does not close F01.
let zero = number(0)
let one = number(1)
var flag: Bool = zero == 1
var truth: Bool = one == 1
var verdict = "P15_F01_PREDICATE_OK"
if flag { verdict = "P15_F01_PREDICATE_FALSE_WRONG" }
if !truth { verdict = "P15_F01_PREDICATE_TRUE_WRONG" }
let semanticResult = text(verdict)
comment("ANCHOR_CARD_15_MID_CENTER")
debugTraceEvent(stage: "after", label: "f01-diag-predicate")
let traceEnvelope = debugExportTrace(runId: "qa-f01-diag-predicate-v2")
let finalSummary = text(f"CHERRI_QA_F01_DIAG_PREDICATE:{semanticResult}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
