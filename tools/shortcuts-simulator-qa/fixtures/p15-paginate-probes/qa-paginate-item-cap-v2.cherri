comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent("before", "item-cap")
var verdict = "P15_PAGINATE_ITEM_CAP_OK"
let rows = paginate("https://raw.githubusercontent.com/davidpovarsky/cherri/38c7098772f4b822d6a3555137c0c7cf8e5b1e5e/docs/apple-runtime/p10r15/paginate-pages/one.json", maxPages: 3, maxItems: 1)
let rowCount = count(rows)
if rowCount != 1 { verdict = "P15_PAGINATE_ITEM_CAP_COUNT_FAIL" }
let first = getFirstItem(rows)
let firstId = getValue(first, "id")
if firstId != 1 { verdict = "P15_PAGINATE_ITEM_CAP_VALUE_FAIL" }
comment("ANCHOR_CARD_15_MID_CENTER")
debugTraceEvent("after", "item-cap")
let traceEnvelope = debugExportTrace("qa-paginate-item-cap-v2")
let finalSummary = text(f"CHERRI_QA_PAGINATE_PROBE_RESULT:{verdict}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
