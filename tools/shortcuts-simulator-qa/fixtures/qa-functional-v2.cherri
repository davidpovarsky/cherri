comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent(stage: "before", label: "step-1-greeting")
let greeting = text("CHERRI_QA_SYNTHETIC_GREETING")
debugLog(withDates: true)
debugTraceEvent(stage: "after", label: "step-1-greeting")

let baseCount = number(2)
debugLog(withDates: true)

let meta = {"suite": "cherri-ios27-simulator-qa", "dialect": "v2", "expectedCount": 2}
debugLog(withDates: true)
let suiteName = getValue(dictionary: meta, key: "suite")
comment("ANCHOR_CARD_15_MID_CENTER")

if baseCount == 2 {
    repeat 2 {
        text("CHERRI_QA_LOOP_TICK")
        debugLog()
    }
} else {
    text("CHERRI_QA_UNEXPECTED_BRANCH")
}

debugTraceEvent(stage: "end", label: "workflow-complete")
let traceEnvelope = debugExportTrace(runId: "qa-functional-v2")
let finalSummary = text(f"CHERRI_QA_RESULT:ok:count=2:mode=v2\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
