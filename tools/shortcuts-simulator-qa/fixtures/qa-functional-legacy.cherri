const greeting = text("CHERRI_QA_SYNTHETIC_GREETING")
debugLog(true)
debugTraceEvent("after", "step-1-greeting")

const baseCount = number(2)
debugLog(true)

const meta = {"suite": "cherri-ios27-simulator-qa", "dialect": "legacy", "expectedCount": 2}
