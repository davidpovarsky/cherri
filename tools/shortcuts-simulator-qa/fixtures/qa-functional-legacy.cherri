#define name Cherri QA Functional Legacy
#define color blue

comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent("before", "step-1-greeting")
const greeting = text("CHERRI_QA_SYNTHETIC_GREETING")
debugLog(true)
debugTraceEvent("after", "step-1-greeting")

const baseCount = number(2)
debugLog(true)

const meta = {"suite": "cherri-ios27-simulator-qa", "dialect": "legacy", "expectedCount": 2}
debugLog(true)
const suiteName = getValue(meta, "suite")
comment("ANCHOR_CARD_15_MID_CENTER")

if baseCount == 2 {
    repeat idx for 2 {
        text("CHERRI_QA_LOOP_TICK")
        debugLog()
    }
} else {
    text("CHERRI_QA_UNEXPECTED_BRANCH")
}

debugTraceEvent("end", "workflow-complete")
const traceEnvelope = debugExportTrace("qa-functional-legacy")
const finalSummary = text("CHERRI_QA_RESULT:ok:count=2:mode=legacy\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
