comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent(stage: "before", label: "retry-http500")
// The harness supplies only a validated loopback port and fresh nonce.
// This is one HTTP operation plus a separate continuation observation, not retry().
let response = downloadURL(f"http://127.0.0.1:{ShortcutInput}/http500")
downloadURL(f"http://127.0.0.1:{ShortcutInput}/continued")
let semanticResult = text(f"CHERRI_QA_RETRY_HTTP500_RESULT:{response}")
comment("ANCHOR_CARD_15_MID_CENTER")
debugTraceEvent(stage: "after", label: "retry-http500")
let traceEnvelope = debugExportTrace(runId: "qa-retry-http500-v2")
let finalSummary = text(f"{semanticResult}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
