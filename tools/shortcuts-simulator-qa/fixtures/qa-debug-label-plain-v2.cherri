// Public fixed label acceptance fixture. Actual values are observed independently.
comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent("before", "label-plain")
let textInput = text("ערך 🍒")
debugLog(withDates: false, showLogs: false, showLogsAsText: false, label: "TEXT_שָׁלוֹם_🍒")
let numberInput = number(7.25)
debugLog(withDates: false, showLogs: false, showLogsAsText: false, label: "")
let mapInput = {"kind": "LABEL_MAP", "value": 7.25}
debugLog(withDates: false, showLogs: false, showLogsAsText: false, label: "MAP_LABEL")
let listInput = ["left", "right"]
debugLog(withDates: false, showLogs: false, showLogsAsText: false, label: "LIST_LABEL")
let dateInput = date("2001-02-03T04:05:06Z")
debugLog(withDates: false, showLogs: false, showLogsAsText: false, label: "DATE_LABEL")
let fileSeed = base64Decode("AQIDBA==")
let fileInput = setName(fileSeed, "label-source.bin", false)
let buffered = debugLog(withDates: false, showLogs: false, showLogsAsText: false, label: "FILE_LABEL")
comment("ANCHOR_CARD_15_MID_CENTER")
let bufferCount = count(buffered, "Items")
let observedText = getListItem(buffered, 1)
let observedNumber = getListItem(buffered, 2)
let observedMap = getListItem(buffered, 3)
let observedListFirst = getListItem(buffered, 4)
let observedListLast = getListItem(buffered, 5)
let observedDate = getListItem(buffered, 6)
let observedFile = getListItem(buffered, 7)
let textType = typeOf(observedText)
let textType64 = base64Encode(textType, lineBreakMode: "None")
let numberType = typeOf(observedNumber)
let numberType64 = base64Encode(numberType, lineBreakMode: "None")
let mapType = typeOf(observedMap)
let mapType64 = base64Encode(mapType, lineBreakMode: "None")
let dateType = typeOf(observedDate)
let dateType64 = base64Encode(dateType, lineBreakMode: "None")
let fileType = typeOf(observedFile)
let fileType64 = base64Encode(fileType, lineBreakMode: "None")
let sourceFileType = typeOf(fileInput)
let sourceFileType64 = base64Encode(sourceFileType, lineBreakMode: "None")
let text64 = base64Encode(observedText, lineBreakMode: "None")
let mapKeys = getKeys(observedMap)
let mapKeysCount = count(mapKeys, "Items")
let mapKind = getValue(observedMap, "kind")
let mapKind64 = base64Encode(mapKind, lineBreakMode: "None")
let mapNumber = getValue(observedMap, "value")
let observedList = getListItems(buffered, 4, 5)
let listCount = count(observedList, "Items")
let listFirst64 = base64Encode(observedListFirst, lineBreakMode: "None")
let listLast64 = base64Encode(observedListLast, lineBreakMode: "None")
let dateCount = count(observedDate, "Items")
let referenceDate = date("2001-02-03T04:05:06Z")
let dateDelta = getTimeBetweenDates(referenceDate, observedDate, "Seconds")
let dateSourceDelta = getTimeBetweenDates(referenceDate, dateInput, "Seconds")
let fileCount = count(observedFile, "Items")
let fileBytes64 = base64Encode(observedFile, lineBreakMode: "None")
let sourceFileBytes64 = base64Encode(fileInput, lineBreakMode: "None")
let fileStem = getName(observedFile)
let fileExtension = getFileDetail(observedFile, "File Extension")
let fileFullName = text(f"{fileStem}.{fileExtension}")
let fileName64 = base64Encode(fileFullName, lineBreakMode: "None")
let sourceFileStem = getName(fileInput)
let sourceFileExtension = getFileDetail(fileInput, "File Extension")
let sourceFileFullName = text(f"{sourceFileStem}.{sourceFileExtension}")
let sourceFileName64 = base64Encode(sourceFileFullName, lineBreakMode: "None")
native.action("is.workflow.actions.getvariable", parameters: { "WFVariable": native.ref("Variable", name: "__cherri_debug_log_labels"), "UUID": "B9F7FBA1-A1B2-43C4-8D55-001122334401", "CustomOutputName": "labelMetadataObserved" })
let labelMetadata = getVariable(native.ref("ActionOutput", uuid: "B9F7FBA1-A1B2-43C4-8D55-001122334401", outputName: "labelMetadataObserved"))
let metadataCount = count(labelMetadata, "Items")
let m1 = getListItem(labelMetadata, 1)
let m1KeyList = getKeys(m1)
let m1Keys = count(m1KeyList, "Items")
let m1First = getValue(m1, "first")
let m1Last = getValue(m1, "last")
let m1Label = getValue(m1, "label")
let m1Label64 = base64Encode(m1Label, lineBreakMode: "None")
let m2 = getListItem(labelMetadata, 2)
let m2KeyList = getKeys(m2)
let m2Keys = count(m2KeyList, "Items")
let m2First = getValue(m2, "first")
let m2Last = getValue(m2, "last")
let m2Label = getValue(m2, "label")
let m2Label64 = base64Encode(m2Label, lineBreakMode: "None")
let m3 = getListItem(labelMetadata, 3)
let m3KeyList = getKeys(m3)
let m3Keys = count(m3KeyList, "Items")
let m3First = getValue(m3, "first")
let m3Last = getValue(m3, "last")
let m3Label = getValue(m3, "label")
let m3Label64 = base64Encode(m3Label, lineBreakMode: "None")
let m4 = getListItem(labelMetadata, 4)
let m4KeyList = getKeys(m4)
let m4Keys = count(m4KeyList, "Items")
let m4First = getValue(m4, "first")
let m4Last = getValue(m4, "last")
let m4Label = getValue(m4, "label")
let m4Label64 = base64Encode(m4Label, lineBreakMode: "None")
let m5 = getListItem(labelMetadata, 5)
let m5KeyList = getKeys(m5)
let m5Keys = count(m5KeyList, "Items")
let m5First = getValue(m5, "first")
let m5Last = getValue(m5, "last")
let m5Label = getValue(m5, "label")
let m5Label64 = base64Encode(m5Label, lineBreakMode: "None")
let m6 = getListItem(labelMetadata, 6)
let m6KeyList = getKeys(m6)
let m6Keys = count(m6KeyList, "Items")
let m6First = getValue(m6, "first")
let m6Last = getValue(m6, "last")
let m6Label = getValue(m6, "label")
let m6Label64 = base64Encode(m6Label, lineBreakMode: "None")
debugClearLogs()
native.action("is.workflow.actions.getvariable", parameters: { "WFVariable": native.ref("Variable", name: "__cherri_debug_log"), "UUID": "B9F7FBA1-A1B2-43C4-8D55-001122334402", "CustomOutputName": "rawClearedObserved" })
let rawCleared = getVariable(native.ref("ActionOutput", uuid: "B9F7FBA1-A1B2-43C4-8D55-001122334402", outputName: "rawClearedObserved"))
let rawClearedCount = count(rawCleared, "Items")
native.action("is.workflow.actions.getvariable", parameters: { "WFVariable": native.ref("Variable", name: "__cherri_debug_log_labels"), "UUID": "B9F7FBA1-A1B2-43C4-8D55-001122334403", "CustomOutputName": "metadataClearedObserved" })
let metadataCleared = getVariable(native.ref("ActionOutput", uuid: "B9F7FBA1-A1B2-43C4-8D55-001122334403", outputName: "metadataClearedObserved"))
let metadataClearedCount = count(metadataCleared, "Items")
debugTraceEvent("after", "label-plain")
let traceEnvelope = debugExportTrace(runId: "qa-debug-label-plain-v2")
let finalSummary = text(f"CHERRI_QA_DEBUG_LABEL:MODE=plain:BUFFER_COUNT={bufferCount}:TEXT_TYPE64={textType64}:TEXT64={text64}:NUMBER_TYPE64={numberType64}:NUMBER={observedNumber}:MAP_TYPE64={mapType64}:MAP_KEYS={mapKeysCount}:MAP_KIND64={mapKind64}:MAP_VALUE={mapNumber}:LIST_COUNT={listCount}:LIST_FIRST64={listFirst64}:LIST_LAST64={listLast64}:DATE_TYPE64={dateType64}:DATE_COUNT={dateCount}:DATE_DELTA_SECONDS={dateDelta}:DATE_SOURCE_DELTA_SECONDS={dateSourceDelta}:FILE_TYPE64={fileType64}:FILE_COUNT={fileCount}:FILE_BYTES64={fileBytes64}:FILE_NAME64={fileName64}:SOURCE_FILE_TYPE64={sourceFileType64}:SOURCE_FILE_BYTES64={sourceFileBytes64}:SOURCE_FILE_NAME64={sourceFileName64}:METADATA_COUNT={metadataCount}:M1_KEYS={m1Keys}:M1_FIRST={m1First}:M1_LAST={m1Last}:M1_LABEL64={m1Label64}:M2_KEYS={m2Keys}:M2_FIRST={m2First}:M2_LAST={m2Last}:M2_LABEL64={m2Label64}:M3_KEYS={m3Keys}:M3_FIRST={m3First}:M3_LAST={m3Last}:M3_LABEL64={m3Label64}:M4_KEYS={m4Keys}:M4_FIRST={m4First}:M4_LAST={m4Last}:M4_LABEL64={m4Label64}:M5_KEYS={m5Keys}:M5_FIRST={m5First}:M5_LAST={m5Last}:M5_LABEL64={m5Label64}:M6_KEYS={m6Keys}:M6_FIRST={m6First}:M6_LAST={m6Last}:M6_LABEL64={m6Label64}:RAW_CLEAR={rawClearedCount}:METADATA_CLEAR={metadataClearedCount}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
