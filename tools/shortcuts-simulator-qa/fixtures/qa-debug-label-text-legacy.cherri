#include 'actions/crypto'
#include 'actions/documents'
#include 'actions/calendar'
// Public fixed label acceptance fixture. Actual values are observed independently.
comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent("before", "label-text")
const textInput = text("ערך 🍒")
debugLog(false, false, false, "TEXT_שָׁלוֹם_🍒")
const numberInput = number(7.25)
debugLog(false, false, false, "")
@mapSeed = {"kind": "LABEL_MAP", "value": 7.25}
const mapInput = getVariable(@mapSeed)
debugLog(false, false, false, "MAP_LABEL")
@listSeed = ["left", "right"]
const listInput = getVariable(@listSeed)
debugLog(false, false, false, "LIST_LABEL")
const dateInput = date("2001-02-03T04:05:06Z")
debugLog(false, false, false, "DATE_LABEL")
const fileSeed = base64Decode("AQIDBA==")
const fileInput = setName(fileSeed, "label-source.bin", false)
const buffered = debugLog(false, false, true, "FILE_LABEL")
comment("ANCHOR_CARD_15_MID_CENTER")
const bufferCount = count(buffered, "Items")
const observedText = getListItem(buffered, 1)
const observedNumber = getListItem(buffered, 2)
const observedMap = getListItem(buffered, 3)
const observedListFirst = getListItem(buffered, 4)
const observedListLast = getListItem(buffered, 5)
const observedDate = getListItem(buffered, 6)
const observedFile = getListItem(buffered, 7)
const textType = typeOf(observedText)
const textType64 = base64Encode(textType, "None")
const numberType = typeOf(observedNumber)
const numberType64 = base64Encode(numberType, "None")
const mapType = typeOf(observedMap)
const mapType64 = base64Encode(mapType, "None")
const dateType = typeOf(observedDate)
const dateType64 = base64Encode(dateType, "None")
const fileType = typeOf(observedFile)
const fileType64 = base64Encode(fileType, "None")
const sourceFileType = typeOf(fileInput)
const sourceFileType64 = base64Encode(sourceFileType, "None")
const text64 = base64Encode(observedText, "None")
const mapKeys = getKeys(observedMap)
const mapKeysCount = count(mapKeys, "Items")
const mapKind = getValue(observedMap, "kind")
const mapKind64 = base64Encode(mapKind, "None")
const mapNumber = getValue(observedMap, "value")
const observedList = getListItems(buffered, 4, 5)
const listCount = count(observedList, "Items")
const listFirst64 = base64Encode(observedListFirst, "None")
const listLast64 = base64Encode(observedListLast, "None")
const dateCount = count(observedDate, "Items")
const referenceDate = date("2001-02-03T04:05:06Z")
const dateDelta = getTimeBetweenDates(referenceDate, observedDate, "Seconds")
const dateSourceDelta = getTimeBetweenDates(referenceDate, dateInput, "Seconds")
const fileCount = count(observedFile, "Items")
const fileBytes64 = base64Encode(observedFile, "None")
const sourceFileBytes64 = base64Encode(fileInput, "None")
const fileStem = getName(observedFile)
const fileExtension = getFileDetail(observedFile, "File Extension")
const fileFullName = text("{fileStem}.{fileExtension}")
const fileName64 = base64Encode(fileFullName, "None")
const sourceFileStem = getName(fileInput)
const sourceFileExtension = getFileDetail(fileInput, "File Extension")
const sourceFileFullName = text("{sourceFileStem}.{sourceFileExtension}")
const sourceFileName64 = base64Encode(sourceFileFullName, "None")
const labelMetadataObserved = rawAction("is.workflow.actions.getvariable", {"WFVariable": {"Value": {"Type": "Variable", "VariableName": "__cherri_debug_log_labels"}, "WFSerializationType": "WFTextTokenAttachment"}, "UUID": "B9F7FBA1-A1B2-43C4-8D55-001122334401", "CustomOutputName": "labelMetadataObserved"})
const labelMetadata = getVariable(labelMetadataObserved)
const metadataCount = count(labelMetadata, "Items")
const m1 = getListItem(labelMetadata, 1)
const m1KeyList = getKeys(m1)
const m1Keys = count(m1KeyList, "Items")
const m1First = getValue(m1, "first")
const m1Last = getValue(m1, "last")
const m1Label = getValue(m1, "label")
const m1Label64 = base64Encode(m1Label, "None")
const m2 = getListItem(labelMetadata, 2)
const m2KeyList = getKeys(m2)
const m2Keys = count(m2KeyList, "Items")
const m2First = getValue(m2, "first")
const m2Last = getValue(m2, "last")
const m2Label = getValue(m2, "label")
const m2Label64 = base64Encode(m2Label, "None")
const m3 = getListItem(labelMetadata, 3)
const m3KeyList = getKeys(m3)
const m3Keys = count(m3KeyList, "Items")
const m3First = getValue(m3, "first")
const m3Last = getValue(m3, "last")
const m3Label = getValue(m3, "label")
const m3Label64 = base64Encode(m3Label, "None")
const m4 = getListItem(labelMetadata, 4)
const m4KeyList = getKeys(m4)
const m4Keys = count(m4KeyList, "Items")
const m4First = getValue(m4, "first")
const m4Last = getValue(m4, "last")
const m4Label = getValue(m4, "label")
const m4Label64 = base64Encode(m4Label, "None")
const m5 = getListItem(labelMetadata, 5)
const m5KeyList = getKeys(m5)
const m5Keys = count(m5KeyList, "Items")
const m5First = getValue(m5, "first")
const m5Last = getValue(m5, "last")
const m5Label = getValue(m5, "label")
const m5Label64 = base64Encode(m5Label, "None")
const m6 = getListItem(labelMetadata, 6)
const m6KeyList = getKeys(m6)
const m6Keys = count(m6KeyList, "Items")
const m6First = getValue(m6, "first")
const m6Last = getValue(m6, "last")
const m6Label = getValue(m6, "label")
const m6Label64 = base64Encode(m6Label, "None")
debugClearLogs()
const rawClearedObserved = rawAction("is.workflow.actions.getvariable", {"WFVariable": {"Value": {"Type": "Variable", "VariableName": "__cherri_debug_log"}, "WFSerializationType": "WFTextTokenAttachment"}, "UUID": "B9F7FBA1-A1B2-43C4-8D55-001122334402", "CustomOutputName": "rawClearedObserved"})
const rawCleared = getVariable(rawClearedObserved)
const rawClearedCount = count(rawCleared, "Items")
const metadataClearedObserved = rawAction("is.workflow.actions.getvariable", {"WFVariable": {"Value": {"Type": "Variable", "VariableName": "__cherri_debug_log_labels"}, "WFSerializationType": "WFTextTokenAttachment"}, "UUID": "B9F7FBA1-A1B2-43C4-8D55-001122334403", "CustomOutputName": "metadataClearedObserved"})
const metadataCleared = getVariable(metadataClearedObserved)
const metadataClearedCount = count(metadataCleared, "Items")
debugTraceEvent("after", "label-text")
const traceEnvelope = debugExportTrace("qa-debug-label-text-legacy")
const finalSummary = text("CHERRI_QA_DEBUG_LABEL:MODE=text:BUFFER_COUNT={bufferCount}:TEXT_TYPE64={textType64}:TEXT64={text64}:NUMBER_TYPE64={numberType64}:NUMBER={observedNumber}:MAP_TYPE64={mapType64}:MAP_KEYS={mapKeysCount}:MAP_KIND64={mapKind64}:MAP_VALUE={mapNumber}:LIST_COUNT={listCount}:LIST_FIRST64={listFirst64}:LIST_LAST64={listLast64}:DATE_TYPE64={dateType64}:DATE_COUNT={dateCount}:DATE_DELTA_SECONDS={dateDelta}:DATE_SOURCE_DELTA_SECONDS={dateSourceDelta}:FILE_TYPE64={fileType64}:FILE_COUNT={fileCount}:FILE_BYTES64={fileBytes64}:FILE_NAME64={fileName64}:SOURCE_FILE_TYPE64={sourceFileType64}:SOURCE_FILE_BYTES64={sourceFileBytes64}:SOURCE_FILE_NAME64={sourceFileName64}:METADATA_COUNT={metadataCount}:M1_KEYS={m1Keys}:M1_FIRST={m1First}:M1_LAST={m1Last}:M1_LABEL64={m1Label64}:M2_KEYS={m2Keys}:M2_FIRST={m2First}:M2_LAST={m2Last}:M2_LABEL64={m2Label64}:M3_KEYS={m3Keys}:M3_FIRST={m3First}:M3_LAST={m3Last}:M3_LABEL64={m3Label64}:M4_KEYS={m4Keys}:M4_FIRST={m4First}:M4_LAST={m4Last}:M4_LABEL64={m4Label64}:M5_KEYS={m5Keys}:M5_FIRST={m5First}:M5_LAST={m5Last}:M5_LABEL64={m5Label64}:M6_KEYS={m6Keys}:M6_FIRST={m6First}:M6_LAST={m6Last}:M6_LABEL64={m6Label64}:RAW_CLEAR={rawClearedCount}:METADATA_CLEAR={metadataClearedCount}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
