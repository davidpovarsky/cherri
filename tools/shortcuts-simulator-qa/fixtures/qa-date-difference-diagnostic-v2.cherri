comment("ANCHOR_CARD_01_TOP_HEADER")
// Public causal Date diagnostic. Actual contradictory fields remain failures.
// No debugLog call: this isolates direct Date/action behavior from log retention.
debugClearLogs()
debugTraceEvent("before", "date-difference")
let startDate = date("2001-02-03T04:05:06Z")
let sameDate = date("2001-02-03T04:05:06Z")
let laterDate = date("2001-02-03T04:06:06Z")
let zeroSeconds = getTimeBetweenDates(startDate, sameDate, "Seconds")
let positiveSeconds = getTimeBetweenDates(startDate, laterDate, "Seconds")
let zeroMinutes = getTimeBetweenDates(startDate, sameDate, "Minutes")
let positiveMinutes = getTimeBetweenDates(startDate, laterDate, "Minutes")
let sameProducerSeconds = getTimeBetweenDates(startDate, startDate, "Seconds")
let numericZero = number(0)
comment("ANCHOR_CARD_15_MID_CENTER")
let startDateType = typeOf(startDate)
let startDateType64 = base64Encode(startDateType, lineBreakMode: "None")
let startDateCount = count(startDate, "Items")
let startDateFormatted = formatTimestamp(startDate, dateFormat: "Custom", timeFormat: "None", customDateFormat: "yyyy-MM-dd'T'HH:mm:ssXXXXX", locale: "en_US_POSIX")
let startDateFormat64 = base64Encode(startDateFormatted, lineBreakMode: "None")
let sameDateType = typeOf(sameDate)
let sameDateType64 = base64Encode(sameDateType, lineBreakMode: "None")
let sameDateCount = count(sameDate, "Items")
let sameDateFormatted = formatTimestamp(sameDate, dateFormat: "Custom", timeFormat: "None", customDateFormat: "yyyy-MM-dd'T'HH:mm:ssXXXXX", locale: "en_US_POSIX")
let sameDateFormat64 = base64Encode(sameDateFormatted, lineBreakMode: "None")
let laterDateType = typeOf(laterDate)
let laterDateType64 = base64Encode(laterDateType, lineBreakMode: "None")
let laterDateCount = count(laterDate, "Items")
let laterDateFormatted = formatTimestamp(laterDate, dateFormat: "Custom", timeFormat: "None", customDateFormat: "yyyy-MM-dd'T'HH:mm:ssXXXXX", locale: "en_US_POSIX")
let laterDateFormat64 = base64Encode(laterDateFormatted, lineBreakMode: "None")
let zeroSecondsType = typeOf(zeroSeconds)
let zeroSecondsType64 = base64Encode(zeroSecondsType, lineBreakMode: "None")
let zeroSecondsCount = count(zeroSeconds, "Items")
let zeroSecondsText = text(f"{zeroSeconds}")
let zeroSecondsText64 = base64Encode(zeroSecondsText, lineBreakMode: "None")
let positiveSecondsType = typeOf(positiveSeconds)
let positiveSecondsType64 = base64Encode(positiveSecondsType, lineBreakMode: "None")
let positiveSecondsCount = count(positiveSeconds, "Items")
let positiveSecondsText = text(f"{positiveSeconds}")
let positiveSecondsText64 = base64Encode(positiveSecondsText, lineBreakMode: "None")
let zeroMinutesType = typeOf(zeroMinutes)
let zeroMinutesType64 = base64Encode(zeroMinutesType, lineBreakMode: "None")
let zeroMinutesCount = count(zeroMinutes, "Items")
let zeroMinutesText = text(f"{zeroMinutes}")
let zeroMinutesText64 = base64Encode(zeroMinutesText, lineBreakMode: "None")
let positiveMinutesType = typeOf(positiveMinutes)
let positiveMinutesType64 = base64Encode(positiveMinutesType, lineBreakMode: "None")
let positiveMinutesCount = count(positiveMinutes, "Items")
let positiveMinutesText = text(f"{positiveMinutes}")
let positiveMinutesText64 = base64Encode(positiveMinutesText, lineBreakMode: "None")
let sameProducerSecondsType = typeOf(sameProducerSeconds)
let sameProducerSecondsType64 = base64Encode(sameProducerSecondsType, lineBreakMode: "None")
let sameProducerSecondsCount = count(sameProducerSeconds, "Items")
let sameProducerSecondsText = text(f"{sameProducerSeconds}")
let sameProducerSecondsText64 = base64Encode(sameProducerSecondsText, lineBreakMode: "None")
let numericZeroType = typeOf(numericZero)
let numericZeroType64 = base64Encode(numericZeroType, lineBreakMode: "None")
let numericZeroCount = count(numericZero, "Items")
let numericZeroText = text(f"{numericZero}")
let numericZeroText64 = base64Encode(numericZeroText, lineBreakMode: "None")
debugTraceEvent("after", "date-difference")
let traceEnvelope = debugExportTrace(runId: "qa-date-difference-diagnostic-v2")
let finalSummary = text(f"CHERRI_QA_DATE_DIFFERENCE_DIAG:START_TYPE64={startDateType64}:START_COUNT={startDateCount}:START_FORMAT64={startDateFormat64}:SAME_TYPE64={sameDateType64}:SAME_COUNT={sameDateCount}:SAME_FORMAT64={sameDateFormat64}:LATER_TYPE64={laterDateType64}:LATER_COUNT={laterDateCount}:LATER_FORMAT64={laterDateFormat64}:ZERO_SECONDS_TYPE64={zeroSecondsType64}:ZERO_SECONDS_COUNT={zeroSecondsCount}:ZERO_SECONDS_TEXT64={zeroSecondsText64}:POSITIVE_SECONDS_TYPE64={positiveSecondsType64}:POSITIVE_SECONDS_COUNT={positiveSecondsCount}:POSITIVE_SECONDS_TEXT64={positiveSecondsText64}:ZERO_MINUTES_TYPE64={zeroMinutesType64}:ZERO_MINUTES_COUNT={zeroMinutesCount}:ZERO_MINUTES_TEXT64={zeroMinutesText64}:POSITIVE_MINUTES_TYPE64={positiveMinutesType64}:POSITIVE_MINUTES_COUNT={positiveMinutesCount}:POSITIVE_MINUTES_TEXT64={positiveMinutesText64}:SAME_PRODUCER_SECONDS_TYPE64={sameProducerSecondsType64}:SAME_PRODUCER_SECONDS_COUNT={sameProducerSecondsCount}:SAME_PRODUCER_SECONDS_TEXT64={sameProducerSecondsText64}:NUMERIC_ZERO_TYPE64={numericZeroType64}:NUMERIC_ZERO_COUNT={numericZeroCount}:NUMERIC_ZERO_TEXT64={numericZeroText64}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
