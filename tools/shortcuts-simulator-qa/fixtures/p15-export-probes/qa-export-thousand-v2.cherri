comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent("before", "thousand")
var verdict = "P15_EXPORT_THOUSAND_OK"
repeat 1000 as exportIndex {
  text(f"entry-{exportIndex}")
  debugLog()
}
let artifact = debugExport("json", false, false, false)
let artifactName = getName(artifact)
let artifactText = getText(artifact)
if artifactName != "cherri-debug.json" { verdict = "P15_EXPORT_FILE_NAME_FAIL" }
let parsed = getDictionary(artifactText)
let entries = getValue(parsed, "entries")
let entryCount = count(entries)
if entryCount != 1000 { verdict = "P15_EXPORT_CARDINALITY_FAIL" }
let firstEntry = getFirstItem(entries)
let status = getValue(firstEntry, "status")
if status != "TEXT_PAYLOAD_ENCODED" { verdict = "P15_EXPORT_TEXT_STATUS_FAIL" }
let payload = getValue(firstEntry, "payload")
let payloadValue = getValue(payload, "value")
repeat 1000 as verifyIndex {
  let indexedEntry = getListItem(entries, verifyIndex)
  let indexedPayload = getValue(indexedEntry, "payload")
  let indexedValue = getValue(indexedPayload, "value")
  let expectedText = text(f"entry-{verifyIndex}")
  let expectedEncoded = base64Encode(expectedText, "None")
  if indexedValue != expectedEncoded { verdict = "P15_EXPORT_ENTRY_ORDER_FAIL" }
}
comment("ANCHOR_CARD_15_MID_CENTER")
debugTraceEvent("after", "thousand")
let traceEnvelope = debugExportTrace("qa-export-thousand-v2")
let finalSummary = text(f"CHERRI_QA_EXPORT_PROBE_RESULT:{verdict}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
