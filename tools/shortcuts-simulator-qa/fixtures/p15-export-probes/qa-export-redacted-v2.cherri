comment("ANCHOR_CARD_01_TOP_HEADER")
debugClearLogs()
debugTraceEvent("before", "redacted")
var verdict = "P15_EXPORT_REDACTED_OK"
let original = text("quote \" backslash \\ newline\nHebrew שָׁלוֹם cherry 🍒 token SYNTHETIC_SECRET")
debugLog()
let artifact = debugExport()
let artifactStem = getName(artifact)
let artifactExtension = getFileDetail(artifact, "File Extension")
let artifactName = text(f"{artifactStem}.{artifactExtension}")
let fileWitness = base64Decode("AQ==")
let expectedFileType = typeOf(fileWitness)
let artifactType = typeOf(artifact)
if artifactType != expectedFileType { verdict = "P15_EXPORT_FILE_TYPE_FAIL" }
let artifactText = getText(artifact)
if artifactName != "cherri-debug.json" { verdict = "P15_EXPORT_FILE_NAME_FAIL" }
let parsed = getDictionary(artifactText)
let entries = getValue(parsed, "entries")
let entryCount = count(entries)
if entryCount != 1 { verdict = "P15_EXPORT_CARDINALITY_FAIL" }
let firstEntry = getFirstItem(entries)
let status = getValue(firstEntry, "status")
if status != "REDACTED" { verdict = "P15_EXPORT_REDACTION_STATUS_FAIL" }
let secretMatches = matchText("SYNTHETIC_SECRET", artifactText)
let secretCount = count(secretMatches)
if secretCount != 0 { verdict = "P15_EXPORT_SECRET_LEAK" }
comment("ANCHOR_CARD_15_MID_CENTER")
debugTraceEvent("after", "redacted")
let traceEnvelope = debugExportTrace("qa-export-redacted-v2")
let finalSummary = text(f"CHERRI_QA_EXPORT_PROBE_RESULT:{verdict}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
output(finalSummary)
