let greeting = text("CHERRI_QA_SYNTHETIC_GREETING")
let baseCount = number(2)
let meta = {"suite": "cherri-ios27-simulator-qa", "dialect": "v2", "expectedCount": 2}
let suiteName = getValue(dictionary: meta, key: "suite")

if baseCount == 2 {
    repeat 2 {
        text("CHERRI_QA_LOOP_TICK")
    }
} else {
    text("CHERRI_QA_UNEXPECTED_BRANCH")
}

let finalSummary = text("CHERRI_QA_RESULT:ok:count=2:mode=v2")
output(finalSummary)
