comment("ANCHOR_CARD_01_TOP_HEADER")
// Public controls only. Dictionary carriers do not establish a nested List type.
debugClearLogs()
debugTraceEvent(stage: "before", label: "nested-list-control")
let flat = ["LEFT", "RIGHT"]
let flatCount = count(flat)
let flatFirst = getFirstItem(flat)
let flatLast = getLastItem(flat)
let flatFirst64 = base64Encode(flatFirst, lineBreakMode: "None")
let flatLast64 = base64Encode(flatLast, lineBreakMode: "None")
let empty = []
let emptyCount = count(empty)
let firstBox = {"tag": "LEFT", "items": ["INNER_A", "INNER_B"]}
let lastBox = {"tag": "EMPTY", "items": []}
let boxes = [firstBox, lastBox]
let boxCount = count(boxes)
let observedFirstBox = getFirstItem(boxes)
let observedLastBox = getLastItem(boxes)
let firstTag = getValue(observedFirstBox, "tag")
let lastTag = getValue(observedLastBox, "tag")
let firstTag64 = base64Encode(firstTag, lineBreakMode: "None")
let lastTag64 = base64Encode(lastTag, lineBreakMode: "None")
let firstKeys = getKeys(observedFirstBox)
let lastKeys = getKeys(observedLastBox)
let firstKeyCount = count(firstKeys)
let lastKeyCount = count(lastKeys)
let firstItems = getValue(observedFirstBox, "items")
let lastItems = getValue(observedLastBox, "items")
let firstItemCount = count(firstItems)
let lastItemCount = count(lastItems)
let firstValue = getFirstItem(firstItems)
let lastValue = getLastItem(firstItems)
let firstValue64 = base64Encode(firstValue, lineBreakMode: "None")
let lastValue64 = base64Encode(lastValue, lineBreakMode: "None")
let textWitness = text("TYPE_WITNESS")
let dictionaryWitness = {"kind": "CONTROL"}
let textType = typeOf(textWitness)
let dictionaryType = typeOf(dictionaryWitness)
let firstType = typeOf(observedFirstBox)
let lastType = typeOf(observedLastBox)
let textType64 = base64Encode(textType, lineBreakMode: "None")
let dictionaryType64 = base64Encode(dictionaryType, lineBreakMode: "None")
let firstType64 = base64Encode(firstType, lineBreakMode: "None")
let lastType64 = base64Encode(lastType, lineBreakMode: "None")
let semanticResult = text(f"CHERRI_NESTED_LIST_CONTROL_V1:FLAT_COUNT={flatCount}:FLAT_FIRST64={flatFirst64}:FLAT_LAST64={flatLast64}:EMPTY_COUNT={emptyCount}:BOX_COUNT={boxCount}:FIRST_TAG64={firstTag64}:LAST_TAG64={lastTag64}:FIRST_KEYS={firstKeyCount}:LAST_KEYS={lastKeyCount}:FIRST_ITEMS={firstItemCount}:FIRST_VALUE64={firstValue64}:LAST_VALUE64={lastValue64}:LAST_ITEMS={lastItemCount}:TEXT_TYPE64={textType64}:DICT_TYPE64={dictionaryType64}:FIRST_TYPE64={firstType64}:LAST_TYPE64={lastType64}")
comment("ANCHOR_CARD_15_MID_CENTER")
debugTraceEvent(stage: "after", label: "nested-list-control")
let traceEnvelope = debugExportTrace(runId: "qa-nested-list-control-v2")
let finalSummary = text(f"{semanticResult}\n{traceEnvelope}")
comment("ANCHOR_CARD_28_BOTTOM_FOOTER")
return finalSummary
