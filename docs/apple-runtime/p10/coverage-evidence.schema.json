{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cherri P10 505 Catalog Coverage Matrix Schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceCommit",
    "inputDependencyFingerprint",
    "totalCatalogEntries",
    "summary",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "inputDependencyFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "totalCatalogEntries": {
      "type": "integer",
      "const": 505
    },
    "summary": {
      "type": "object",
      "required": [
        "totalEntries",
        "callableActions",
        "compilerConstructs",
        "legacySupportedCount",
        "v2SupportedCount",
        "plistIdentifierVerifiedCount",
        "parameterContractVerifiedCount",
        "decompileSupportedCount",
        "roundTripVerifiedCount",
        "structuralRoundTripVerifiedCount",
        "nativeSpecimenParityCount",
        "appleRuntimeExecutedCount",
        "blockedDeviceCount",
        "needsEvidenceCount",
        "pureOriginalSupportedCount",
        "purePlusPackSupportedCount",
        "p10OnlyGoRequiredCount",
        "requiresAppIntentDescriptorCount",
        "evidenceTierCounts",
        "decompileModeCounts",
        "coverageDimensionsSummary"
      ],
      "properties": {
        "totalEntries": { "type": "integer", "const": 505 },
        "callableActions": { "type": "integer", "const": 497 },
        "compilerConstructs": { "type": "integer", "const": 8 },
        "legacySupportedCount": { "type": "integer", "minimum": 0, "maximum": 505 },
        "v2SupportedCount": { "type": "integer", "minimum": 0, "maximum": 505 },
        "plistIdentifierVerifiedCount": { "type": "integer", "minimum": 0, "maximum": 505 },
        "parameterContractVerifiedCount": { "type": "integer", "minimum": 0, "maximum": 505 },
        "decompileSupportedCount": { "type": "integer", "minimum": 0, "maximum": 505 },
        "roundTripVerifiedCount": { "type": "integer", "minimum": 0, "maximum": 505 },
        "structuralRoundTripVerifiedCount": { "type": "integer", "minimum": 0, "maximum": 505 },
        "nativeSpecimenParityCount": { "type": "integer", "minimum": 0, "maximum": 505 },
        "appleRuntimeExecutedCount": { "type": "integer", "minimum": 0, "maximum": 505 },
        "blockedDeviceCount": { "type": "integer", "minimum": 0, "maximum": 505 },
        "needsEvidenceCount": { "type": "integer", "minimum": 0, "maximum": 505 },
        "pureOriginalSupportedCount": { "type": "integer", "minimum": 0, "maximum": 505 },
        "purePlusPackSupportedCount": { "type": "integer", "minimum": 0, "maximum": 505 },
        "p10OnlyGoRequiredCount": { "type": "integer", "minimum": 0, "maximum": 505 },
        "requiresAppIntentDescriptorCount": { "type": "integer", "minimum": 0, "maximum": 505 }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 505,
      "maxItems": 505,
      "items": {
        "type": "object",
        "required": [
          "cherriName",
          "shortcutIdentifier",
          "entryKind",
          "sourceFile",
          "sourceLine",
          "osAvailability",
          "legacySupported",
          "v2Supported",
          "plistIdentifierVerified",
          "parameterContractVerified",
          "decompileSupported",
          "decompileMode",
          "roundTripVerified",
          "structuralRoundTripPass",
          "nativeSpecimenParityStatus",
          "appleRuntimeExecutedStatus",
          "verificationStatuses",
          "allowedExclusions",
          "coverageDimensions",
          "pureOriginalSupported",
          "purePlusPackSupported",
          "packSupportKind",
          "evidenceTier",
          "runtimeVerificationState",
          "unitTestRef",
          "emittedParameterKeys",
          "knownLimitations"
        ],
        "properties": {
          "cherriName": { "type": "string", "minLength": 1 },
          "shortcutIdentifier": { "type": "string", "minLength": 1 },
          "entryKind": { "type": "string", "enum": ["action", "compilerConstruct"] },
          "sourceFile": { "type": "string", "minLength": 1 },
          "sourceLine": { "type": "integer", "minimum": 1 },
          "osAvailability": {
            "type": "object",
            "required": ["macOnly", "nonMacOnly", "minVersion", "maxVersion", "targetSummary"],
            "properties": {
              "macOnly": { "type": "boolean" },
              "nonMacOnly": { "type": "boolean" },
              "minVersion": { "type": "number" },
              "maxVersion": { "type": "number" },
              "targetSummary": { "type": "string", "minLength": 1 }
            }
          },
          "legacySupported": { "type": "boolean" },
          "v2Supported": { "type": "boolean" },
          "plistIdentifierVerified": { "type": "boolean" },
          "parameterContractVerified": { "type": "boolean" },
          "decompileSupported": { "type": "boolean" },
          "decompileMode": {
            "type": "string",
            "enum": [
              "native_cherri_call",
              "rawAction_lossless_fallback",
              "native_control_flow",
              "UNSUPPORTED"
            ]
          },
          "roundTripVerified": { "type": "boolean" },
          "structuralRoundTripPass": { "type": "boolean" },
          "nativeSpecimenParityStatus": {
            "type": "string",
            "enum": [
              "NATIVE_SPECIMEN_PARITY_PASS",
              "NATIVE_SPECIMEN_PARITY_FAIL",
              "SPECIMEN_MISSING",
              "SPECIMEN_INVALID",
              "SPECIMEN_PLATFORM_MISMATCH",
              "NEEDS_EVIDENCE",
              "UNSUPPORTED"
            ]
          },
          "appleRuntimeExecutedStatus": {
            "type": "string",
            "enum": [
              "APPLE_RUNTIME_EXECUTED",
              "BLOCKED_DEVICE",
              "NEEDS_EVIDENCE",
              "UNSUPPORTED"
            ]
          },
          "verificationStatuses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "CATALOG_DISCOVERED",
                "SCHEMA_REGISTERED",
                "LEGACY_COMPILE_PASS",
                "V2_COMPILE_PASS",
                "PLIST_IDENTIFIER_PASS",
                "PARAMETER_CONTRACT_PASS",
                "DECOMPILE_PASS",
                "STRUCTURAL_ROUNDTRIP_PASS",
                "NATIVE_SPECIMEN_PARITY_PASS",
                "NATIVE_SPECIMEN_PARITY_FAIL",
                "SPECIMEN_MISSING",
                "SPECIMEN_INVALID",
                "SPECIMEN_PLATFORM_MISMATCH",
                "APPLE_RUNTIME_EXECUTED",
                "BLOCKED_DEVICE",
                "UNSUPPORTED",
                "NEEDS_EVIDENCE"
              ]
            }
          },
          "allowedExclusions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "coverageDimensions": {
            "type": "object",
            "required": [
              "1_appleRuntimeDiscovery",
              "2_appleActionEligibility",
              "3_appleIdentifierMappedToCherri",
              "4_cherriCallableCompiled",
              "5_nativePlistSpecimenCompared",
              "6_runtimeExecutionVerified",
              "7_purePlusPackPortability"
            ]
          },
          "pureOriginalSupported": { "type": "boolean" },
          "purePlusPackSupported": { "type": "boolean" },
          "packSupportKind": {
            "type": "string",
            "enum": [
              "UPSTREAM_CORE",
              "PACK_DECLARATIVE_MODULE",
              "REQUIRES_APPINTENT_DESCRIPTOR",
              "P10_ONLY_GO_REQUIRED"
            ]
          },
          "evidenceTier": {
            "type": "string",
            "enum": [
              "COMPILER_VERIFIED",
              "STRUCTURAL_ROUNDTRIP_VERIFIED",
              "NATIVE_SPECIMEN_VERIFIED",
              "APPLE_RUNTIME_VERIFIED"
            ]
          },
          "runtimeVerificationState": {
            "type": "string",
            "enum": [
              "COMPILE_AND_ROUNDTRIP_VERIFIED",
              "COMPILE_VERIFIED_ONLY",
              "MACOS27_STATIC_EXTRACTED_AND_COMPILED",
              "MACOS27_RUNTIME_EXTRACTED_AND_COMPILED",
              "PHYSICAL_IPAD_PENDING"
            ]
          },
          "unitTestRef": { "type": "string", "minLength": 1 },
          "emittedParameterKeys": {
            "type": "array",
            "items": { "type": "string" }
          },
          "knownLimitations": { "type": "string" }
        }
      }
    }
  }
}
