   {
    "WFWorkflowActionIdentifier": "is.workflow.actions.comment",
    "WFWorkflowActionParameters": {
     "WFCommentActionText": "Create a structured dictionary with \u201cUse Model\u201d by tapping the \u201c\u29c1\u201d button to expand the action and selecting \u201cDictionary\u201d as the output.\n\nThis example uses a model to create a list of planets and their corresponding diameters, then gets Earth\u2019s diameter from the list using the \u201cGet Dictionary Value\u201d action."
    }
   },
   {
    "WFWorkflowActionIdentifier": "is.workflow.actions.askllm",
