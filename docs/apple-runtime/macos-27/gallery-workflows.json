   {
    "WFWorkflowActionIdentifier": "is.workflow.actions.comment",
    "WFWorkflowActionParameters": {
     "WFCommentActionText": "This example demonstrates how you can sort and filter lists using a language model. This also works with lists of content that are passed in, like calendar events or reminders!"
