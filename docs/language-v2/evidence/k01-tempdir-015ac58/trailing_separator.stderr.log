++ awk '
    BEGIN { in_str=0; esc=0; depth=0 }
    {
      for (i=1; i<=length($0); i++) {
        c = substr($0, i, 1)
        if (esc) { esc=0; continue }
        if (c == "\\") { if (in_str) esc=1; continue }
        if (c == "\"") { in_str = !in_str; continue }
        if (!in_str) {
          if (c == "{") depth++
          else if (c == "}") depth--
        }
      }
    }
    END {
      if (in_str != 0 || depth != 0) exit 1
    }
  '
