+let zeroResult = optionalNumber(optionalNumber(0))
+var zeroObserved = "NONE"
+if zeroResult != none { zeroObserved = text(f"NUMBER[{zeroResult}]") }
+let emptyListResult = optionalList(optionalList([]))
+var emptyListObserved = "NONE"
+if emptyListResult != none {
