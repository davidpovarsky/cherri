+    mapObserved = text(f"MAP[{keyCount}|{item}|{nativeType}]")
+}
+
+var candidate: Text? = none
+let snapshotResult = optionalPick(candidate, if true { candidate = ""; yield "WRITTEN" } else { yield "UNUSED" })
