+	receipt, err := json.Marshal(map[string]any{"requirement": id, "source_sha": runner.implSHA, "scope": scenario.Scope, "report": report, "records": runner.records})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Log("P15_PACKAGED_SKILL_PRODUCTION_RECEIPT:" + string(receipt))
+}
