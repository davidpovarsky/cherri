@@ -0,0 +1,90 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"testing"
+)
+
+func p15DictionaryIndexBoundarySource(name string) string {
+	body := ""
+	switch name {
+	case "capture":
+		body = `var state="BEFORE";getVariable({"key":state,"later":if true{state="AFTER";yield "SECOND"}else{yield "UNUSED"}}["key"])`
+	case "reserved_keys":
+		body = `getVariable({"WFSerializationType":"WFTextTokenString","Value":{"string":"WRONG"},"key":""}["key"])`
+	case "empty_list":
+		body = `getVariable({"key":[]}["key"])`
+	case "empty_map":
+		body = `getVariable({"key":{}}["key"])`
+	default:
+		panic("unknown direct Dictionary boundary")
+	}
+	return "function probe()->Text{" + body + `;return "DONE"}` + "\ngetVariable(probe())"
+}
+
+func p15DictionaryKeyEdge(dictionary, key string) map[string]any {
+	return p15FunctionAttachment(map[string]any{"Type": "ActionOutput", "OutputUUID": dictionary,
+		"Aggrandizements": []any{map[string]any{"Type": "WFDictionaryValueVariableAggrandizement", "DictionaryKey": key}}})
+}
+
+func p15DictionaryIndexBoundaryGraphError(actions []map[string]any, name string) error {
+	g := &p15FunctionGraph{actual: actions, groups: map[string]bool{}}
+	g.header("probe")
+	values := map[string]any{}
+	switch name {
+	case "capture":
+		before := g.value("gettext", map[string]any{"WFTextActionText": "BEFORE"})
+		g.emit("setvariable", map[string]any{"WFVariableName": "state", "WFInput": p15FunctionEdge(before)})
+		early := g.value("getvariable", map[string]any{"WFVariable": p15FunctionVariable("state")})
+		condition := g.value("number", map[string]any{"WFNumberActionNumber": 1})
+		group := g.conditional(4, p15FunctionEdge(condition), "WFNumberValue", 1)
+		after := g.value("gettext", map[string]any{"WFTextActionText": "AFTER"})
+		g.emit("setvariable", map[string]any{"WFVariableName": "state", "WFInput": p15FunctionEdge(after)})
+		g.value("gettext", map[string]any{"WFTextActionText": "SECOND"})
+		g.boundary(group, 1, false)
+		g.value("gettext", map[string]any{"WFTextActionText": "UNUSED"})
+		later := g.boundary(group, 2, true)
+		values = map[string]any{"key": p15ContainerReference{"Type": "ActionOutput", "OutputUUID": early}, "later": p15ContainerReference{"Type": "ActionOutput", "OutputUUID": later}}
+	case "reserved_keys":
+		values = map[string]any{"WFSerializationType": "WFTextTokenString", "Value": map[string]any{"string": "WRONG"}, "key": ""}
+	case "empty_list":
+		values["key"] = []any{}
+	case "empty_map":
+		values["key"] = map[string]any{}
+	default:
+		return fmt.Errorf("unmodeled direct Dictionary boundary %q", name)
+	}
+	_, wire := p15ContainerFieldValue(values)
+	dictionary := g.value("dictionary", map[string]any{"WFItems": wire})
+	// Both established static-key transports are valid: a native lookup action
+	// or the exact Dictionary-key aggrandizement. Model every parameter and
+	// action of the selected form; neither permits losing Dictionary identity.
+	var selected any = p15DictionaryKeyEdge(dictionary, "key")
+	if next := len(g.expected); next < len(actions) && actions[next]["WFWorkflowActionIdentifier"] == "is.workflow.actions.getvalueforkey" {
+		selected = p15FunctionEdge(g.get("key", dictionary))
+	}
+	g.emit("getvariable", map[string]any{"WFVariable": selected})
+	g.output(g.value("gettext", map[string]any{"WFTextActionText": "DONE"}))
+	g.caller()
+	result := g.call(g.payload("probe"))
+	g.emit("getvariable", map[string]any{"WFVariable": p15FunctionEdge(result)})
+	return g.finish()
+}
+
+func TestP15OptionalDictionaryDirectIndexKeepsTypedValuesAndOrder(t *testing.T) {
+	for _, name := range []string{"capture", "reserved_keys", "empty_list", "empty_map"} {
+		t.Run(name, func(t *testing.T) {
+			actions := p15CompiledActions(t, p15DictionaryIndexBoundarySource(name))
+			if err := p15DictionaryIndexBoundaryGraphError(actions, name); err != nil {
+				if os.MkdirAll("dist/p15-optional-dictionary", 0700) == nil {
+					if raw, e := json.MarshalIndent(actions, "", "  "); e == nil {
+						_ = os.WriteFile("dist/p15-optional-dictionary/direct-index-baseline-"+name+".json", raw, 0600)
+					}
+				}
+				t.Fatal(err)
+			}
+		})
+	}
+}
diff --git a/p15_optional_dictionary_oracle_test.go b/p15_optional_dictionary_oracle_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..4998377465a04eefd9b150404737483e64c41544
--- /dev/null
+++ b/p15_optional_dictionary_oracle_test.go
@@ -0,0 +1,233 @@
+package main
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+)
+
+func p15OptionalDictionaryLiteralValue(name string) any {
+	switch name {
+	case "text":
+		return "ready"
+	case "empty_text":
+		return ""
+	case "false":
+		return false
+	case "zero":
+		return p15ContainerNumber("0")
+	case "empty_list":
+		return []any{}
+	case "list":
+		return []any{"one", "two"}
+	case "empty_map":
+		return map[string]any{}
+	case "map":
+		return map[string]any{"nested": "VALUE"}
+	default:
+		panic("unknown Dictionary literal")
+	}
+}
+
+// Require retains its actual count/type rejection path and returns the exact
+// original Dictionary edge. These checks do not infer the indexed key exists;
+// that separate fact originates in the authored literal, not native truthiness.
+func p15OptionalDictionaryRequireGraph(g *p15FunctionGraph, dictionary string) string {
+	count := g.value("count", map[string]any{"Input": p15FunctionEdge(dictionary), "WFCountType": "Items"})
+	reject := func(input string, field string, operand any) {
+		group := g.conditional(5, p15FunctionEdge(input), field, operand)
+		g.emit("alert", map[string]any{"WFAlertActionMessage": "Requirement failed", "WFAlertActionCancelButtonShown": false})
+		g.emit("exit", nil)
+		g.boundary(group, 2, false)
+	}
+	reject(count, "WFNumberValue", 1)
+	actual := g.value("getitemtype", map[string]any{"WFInput": p15FunctionEdge(dictionary)})
+	_, sample := p15ContainerFieldValue(map[string]any{"cherri_type_witness": true})
+	witness := g.value("dictionary", map[string]any{"WFItems": sample})
+	expected := g.value("getitemtype", map[string]any{"WFInput": p15FunctionEdge(witness)})
+	reject(actual, "WFConditionalActionString", p15FunctionText("\ufffc", expected))
+	return g.value("getvariable", map[string]any{"WFVariable": p15FunctionEdge(dictionary)})
+}
+
+func p15OptionalDictionaryGraphError(actions []map[string]any, tc p15OptionalDictionaryCase, route string) error {
+	g := &p15FunctionGraph{actual: actions, groups: map[string]bool{}}
+	envelope := g.header("echo")
+	value, presence := p15DecodeOptionalArgumentGraph(g, envelope, 0)
+	p15ForwardResultGraph(g, value, presence)
+	g.caller()
+	_, wire := p15ContainerFieldValue(map[string]any{"key": p15OptionalDictionaryLiteralValue(tc.name)})
+	dictionary := g.value("dictionary", map[string]any{"WFItems": wire})
+	if route == "require" || route == "named_require_alias" {
+		dictionary = p15OptionalDictionaryRequireGraph(g, dictionary)
+	}
+	output, _ := p15ForwardCallGraph(g, "echo", p15FunctionArgument{true, 0, p15DictionaryKeyEdge(dictionary, "key")}, "1", nil, nil)
+	g.emit("getvariable", map[string]any{"WFVariable": p15FunctionEdge(output)})
+	return g.finish()
+}
+
+func TestP15OptionalDictionaryCompleteNativeGraph(t *testing.T) {
+	for _, tc := range p15OptionalDictionaryCases() {
+		for _, route := range []string{"literal", "alias", "require", "named_require_alias"} {
+			t.Run(tc.name+"/"+route, func(t *testing.T) {
+				if err := p15OptionalDictionaryGraphError(p15CompiledActions(t, p15OptionalDictionarySource(tc, route, "argument")), tc, route); err != nil {
+					t.Fatal(err)
+				}
+			})
+		}
+	}
+}
+
+func TestP15OptionalDictionaryImportedBodyAndDemand(t *testing.T) {
+	// An imported function consumes a mutable caller binding. The unchanged
+	// complete forwarding oracle requires the private flag assignment/edges.
+	entry := "import \"./dependency.cherri\" as dep\nvar candidate:Text?=none\ngetVariable(dep.echo(candidate))"
+	dependency := "function echo(value:Text?)->Text?{return value}\n"
+	path, source := p15ModuleProject(t, map[string]string{"main.cherri": entry, "dependency.cherri": dependency})
+	actions := p15OptionalAliasModuleActions(t, path, source, "module:dependency.cherri::echo")
+	if err := p15OptionalForwardingGraphError(actions, "mutable_none"); err != nil {
+		t.Fatal(err)
+	}
+	// The indexed proof belongs to the dependency's exact AST, not the caller.
+	for _, tc := range p15OptionalDictionaryCases() {
+		t.Run(tc.name, func(t *testing.T) {
+			prefix, selected := p15OptionalDictionarySelection(tc, "require")
+			dependency = "function echo()->" + tc.typ + "?{" + prefix + "return " + selected + "}\n"
+			entry = "import \"./dependency.cherri\" as dep\ngetVariable(dep.echo())"
+			path, source = p15ModuleProject(t, map[string]string{"main.cherri": entry, "dependency.cherri": dependency})
+			actions = p15OptionalAliasModuleActions(t, path, source, "module:dependency.cherri::echo")
+			g := &p15FunctionGraph{actual: actions, groups: map[string]bool{}}
+			g.header("echo")
+			_, wire := p15ContainerFieldValue(map[string]any{"key": p15OptionalDictionaryLiteralValue(tc.name)})
+			dictionary := g.value("dictionary", map[string]any{"WFItems": wire})
+			dictionary = p15OptionalDictionaryRequireGraph(g, dictionary)
+			carrier := p15OptionalCarrierGraph(g, "has_value", "value", "_cherri_optional_result_v1", true, p15FunctionArgument{true, 0, p15DictionaryKeyEdge(dictionary, "key")})
+			g.output(carrier)
+			g.caller()
+			result := g.call(g.payload("echo"))
+			value, _ := p15DecodeOptionalGraph(g, result, "has_value", "value")
+			g.emit("getvariable", map[string]any{"WFVariable": p15FunctionEdge(value)})
+			if err := g.finish(); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func p15MutateDictionaryLookupGraph(actions []map[string]any, fault string) bool {
+	for _, a := range actions {
+		p := p15Param(a)
+		kind, _ := a["WFWorkflowActionIdentifier"].(string)
+		if kind == "is.workflow.actions.dictionary" {
+			fields, err := p15ContainerFields(p["WFItems"])
+			if err != nil {
+				continue
+			}
+			if row := fields["key"]; row != nil {
+				switch fault {
+				case "wrong_key":
+					row["WFKey"] = p15FunctionText("other")
+					return true
+				case "wrong_kind":
+					row["WFItemType"] = 3
+					return true
+				case "omitted_empty_array":
+					delete(row["WFValue"].(map[string]any), "Value")
+					return true
+				case "empty_as_none":
+					row["WFValue"] = p15FunctionText("")
+					return true
+				}
+			}
+			if fields["cherri_type_witness"] != nil && fault == "wrong_type_witness" {
+				fields["cherri_type_witness"]["WFValue"] = p15FunctionText("true")
+				return true
+			}
+			if fields["_cherri_optional_argument_v1"] != nil {
+				switch fault {
+				case "wrong_presence":
+					fields["has_value"]["WFValue"] = p15FunctionText("0")
+					return true
+				case "value_as_presence":
+					fields["has_value"]["WFValue"] = fields["value"]["WFValue"]
+					return true
+				case "wrong_lookup":
+					descriptor := fields["value"]["WFValue"].(map[string]any)["Value"].(map[string]any)
+					descriptor["Aggrandizements"].([]any)[0].(map[string]any)["DictionaryKey"] = "other"
+					return true
+				}
+			}
+		}
+		if kind == "is.workflow.actions.count" && fault == "wrong_count_input" {
+			p["Input"] = p15FunctionVariable("unrelated")
+			return true
+		}
+		if kind == "is.workflow.actions.conditional" && p15Int(p["WFCondition"]) == 5 && p["WFNumberValue"] != nil && fault == "wrong_count_guard" {
+			p["WFNumberValue"] = 0
+			return true
+		}
+		if kind == "is.workflow.actions.alert" && fault == "ignored_rejection" {
+			p["WFAlertActionCancelButtonShown"] = true
+			return true
+		}
+		if kind == "is.workflow.actions.getvariable" && p["UUID"] != nil && fault == "wrong_passthrough" {
+			p["WFVariable"] = p15FunctionVariable("unrelated")
+			return true
+		}
+	}
+	return false
+}
+
+func TestP15OptionalDictionaryNativeOracleRejectsCorruption(t *testing.T) {
+	tc := p15OptionalDictionaryCases()[4]
+	original := p15CompiledActions(t, p15OptionalDictionarySource(tc, "require", "argument"))
+	if err := p15OptionalDictionaryGraphError(original, tc, "require"); err != nil {
+		t.Fatal(err)
+	}
+	for _, fault := range []string{"wrong_key", "wrong_kind", "omitted_empty_array", "empty_as_none", "wrong_type_witness", "wrong_presence", "value_as_presence", "wrong_lookup", "wrong_count_input", "wrong_count_guard", "ignored_rejection", "wrong_passthrough"} {
+		t.Run(fault, func(t *testing.T) {
+			changed := p15ContainerCloneNative(t, original)
+			if err := p15OptionalDictionaryGraphError(changed, tc, "require"); err != nil {
+				t.Fatal("unchanged clone rejected", err)
+			}
+			if !p15MutateDictionaryLookupGraph(changed, fault) {
+				t.Fatal("mutation not applied", fault)
+			}
+			if err := p15OptionalDictionaryGraphError(changed, tc, "require"); err == nil {
+				t.Fatal("wrong Dictionary/presence edge accepted", fault)
+			}
+		})
+	}
+	for _, name := range []string{"capture", "reserved_keys", "empty_list", "empty_map"} {
+		t.Run("direct/"+name, func(t *testing.T) {
+			actual := p15CompiledActions(t, p15DictionaryIndexBoundarySource(name))
+			if err := p15DictionaryIndexBoundaryGraphError(actual, name); err != nil {
+				t.Fatal(err)
+			}
+			changed := p15ContainerCloneNative(t, actual)
+			applied := false
+			for i, a := range changed {
+				p := p15Param(a)
+				if name == "capture" && a["WFWorkflowActionIdentifier"] == "is.workflow.actions.getvariable" && strings.Contains(fmt.Sprint(p["WFVariable"]), "state") {
+					changed = append(changed[:i], changed[i+1:]...)
+					applied = true
+					break
+				}
+				if name != "capture" && a["WFWorkflowActionIdentifier"] == "is.workflow.actions.dictionary" {
+					fields, err := p15ContainerFields(p["WFItems"])
+					if err != nil || fields["key"] == nil {
+						continue
+					}
+					fields["key"]["WFValue"] = p15FunctionText("LOST")
+					applied = true
+					break
+				}
+			}
+			if !applied {
+				t.Fatal("direct boundary mutation not applied")
+			}
+			if err := p15DictionaryIndexBoundaryGraphError(changed, name); err == nil {
+				t.Fatal("direct value loss accepted")
+			}
+		})
+	}
+}
diff --git a/p15_optional_dictionary_presence_test.go b/p15_optional_dictionary_presence_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..72a6098e81b8ae3b1f0e314c4df1440866d28ac4
--- /dev/null
+++ b/p15_optional_dictionary_presence_test.go
@@ -0,0 +1,144 @@
+package main
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/electrikmilk/cherri/internal/language/analysis"
+	"github.com/electrikmilk/cherri/internal/language/service"
+)
+
+type p15OptionalDictionaryCase struct{ name, typ, value string }
+
+func p15OptionalDictionaryCases() []p15OptionalDictionaryCase {
+	return []p15OptionalDictionaryCase{
+		{"text", "Text", `"ready"`}, {"empty_text", "Text", `""`},
+		{"false", "Bool", `false`}, {"zero", "Number", `0`},
+		{"empty_list", "List<Unknown>", `[]`}, {"list", "List<Text>", `["one","two"]`},
+		{"empty_map", "Map<Text,AnyContent>", `{}`}, {"map", "Map<Text,Text>", `{"nested":"VALUE"}`},
+	}
+}
+
+func p15OptionalDictionarySelection(tc p15OptionalDictionaryCase, route string) (prefix, selected string) {
+	dictionary := `{"key":` + tc.value + `}`
+	switch route {
+	case "literal":
+		return "", dictionary + `["key"]`
+	case "alias":
+		return "let source=" + dictionary + ";let alias=source;", `alias["key"]`
+	case "require":
+		return "let checked=require(" + dictionary + `,type:"dictionary");`, `checked["key"]`
+	case "named_require_alias":
+		return "let source=" + dictionary + `;let checked=require(type:"dictionary",value:source);let alias=checked;`, `alias["key"]`
+	default:
+		panic("unknown Dictionary provenance route")
+	}
+}
+
+func p15OptionalDictionarySource(tc p15OptionalDictionaryCase, route, consumer string) string {
+	prefix, selected := p15OptionalDictionarySelection(tc, route)
+	switch consumer {
+	case "binding":
+		return prefix + "let value:" + tc.typ + "?=" + selected + ";getVariable(value!=none)"
+	case "argument":
+		return "function echo(value:" + tc.typ + "?)->" + tc.typ + "?{return value}\n" + prefix + "getVariable(echo(" + selected + "))"
+	case "return":
+		return "function pick()->" + tc.typ + "?{" + prefix + "return " + selected + "}\ngetVariable(pick())"
+	default:
+		panic("unknown Dictionary Optional consumer")
+	}
+}
+
+func TestP15OptionalDictionaryPublicRoutes(t *testing.T) {
+	for _, tc := range p15OptionalDictionaryCases() {
+		for _, route := range []string{"literal", "alias", "require", "named_require_alias"} {
+			for _, consumer := range []string{"binding", "argument", "return"} {
+				t.Run(tc.name+"/"+route+"/"+consumer, func(t *testing.T) {
+					source := p15OptionalDictionarySource(tc, route, consumer)
+					for _, d := range p15TypeDiagnostics(t, source) {
+						if d.Severity == analysis.SeverityError {
+							t.Fatal(d)
+						}
+					}
+					if raw, err := CompileSourceToPlist("p15-owned-dictionary.cherri", source); err != nil || len(raw) == 0 {
+						t.Fatalf("source-owned Dictionary slot failed: bytes=%d error=%v", len(raw), err)
+					}
+					svc := service.NewService(nil)
+					uri := "file:///p15-owned-dictionary.cherri"
+					svc.OpenDocument(uri, 1, source)
+					diagnostics, _ := svc.Analyze(uri)
+					for _, d := range diagnostics {
+						if d.Severity == analysis.SeverityError {
+							t.Fatal("editor disagrees", d)
+						}
+					}
+				})
+			}
+		}
+	}
+}
+
+func p15OptionalDictionaryNegatives() []p15OptionalIndexNegative {
+	return []p15OptionalIndexNegative{
+		{"missing_key", `let selected:Text?={"other":"ready"}["key"]`, `{"other":"ready"}["key"]`, nil},
+		{"duplicate_key", `let selected:Text?={"key":"first","key":"last"}["key"]`, `{"key":"first","key":"last"}["key"]`, nil},
+		{"dynamic_key", `let key="key";let selected:Text?={"key":"ready"}[key]`, `{"key":"ready"}[key]`, nil},
+		{"computed_key", `let selected:Text?={text("key"):"ready"}["key"]`, `{text("key"):"ready"}["key"]`, nil},
+		{"mutable_target", `var values={"key":"ready"};let selected:Text?=values["key"]`, `values["key"]`, nil},
+		{"mutable_alias", `var values={"key":"ready"};let alias=values;values={"other":"changed"};let selected:Text?=alias["key"]`, `alias["key"]`, nil},
+		{"require_mutable_alias", `var values={"key":"ready"};let alias=values;let checked=require(alias,type:"dictionary");let selected:Text?=checked["key"]`, `checked["key"]`, nil},
+		{"require_missing_key", `let checked=require({"other":"ready"},type:"dictionary");let selected:Text?=checked["key"]`, `checked["key"]`, nil},
+		{"user_require", `function require(value:Map<Text,Text>)->Map<Text,Text>{return {"other":"different"}};let checked=require({"key":"ready"});let selected:Text?=checked["key"]`, `checked["key"]`, nil},
+		{"opaque_target", `let checked=require(native.action("is.workflow.actions.nothing",{}),type:"dictionary");let selected:AnyContent?=checked["key"]`, `checked["key"]`, nil},
+		{"optional_entry", `let maybe:Text?=none;let selected:Text?={"key":maybe}["key"]`, `{"key":maybe}["key"]`, []string{"maybe"}},
+		{"opaque_entry", `let selected:AnyContent?={"key":native.action("is.workflow.actions.nothing",{})}["key"]`, `{"key":native.action("is.workflow.actions.nothing",{})}["key"]`, nil},
+	}
+}
+
+func p15OptionalDictionaryBoundaryError(diagnostics []analysis.Diagnostic, tc p15OptionalIndexNegative) error {
+	if tc.name != "duplicate_key" {
+		return p15OptionalIndexBoundaryError(diagnostics, tc)
+	}
+	kept := []analysis.Diagnostic{}
+	duplicates := 0
+	start := strings.Index(tc.source, `,"key"`) + 1
+	for _, d := range diagnostics {
+		if d.Code == "E_DUPLICATE_KEY" && d.Severity == analysis.SeverityError {
+			if d.Span.Start.ByteOffset != start || d.Span.End.ByteOffset != start+len(`"key"`) {
+				return fmt.Errorf("duplicate key diagnostic lost its exact second-key span: %+v", d)
+			}
+			duplicates++
+		} else {
+			kept = append(kept, d)
+		}
+	}
+	if duplicates != 1 {
+		return fmt.Errorf("want one actual duplicate-key rejection, got %+v", diagnostics)
+	}
+	return p15OptionalIndexBoundaryError(kept, tc)
+}
+
+func TestP15OptionalDictionaryRejectsUnprovenOrigins(t *testing.T) {
+	for _, tc := range p15OptionalDictionaryNegatives() {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := p15OptionalDictionaryBoundaryError(p15TypeDiagnostics(t, tc.source), tc); err != nil {
+				t.Fatal(err)
+			}
+			code := analysis.CodeTargetValueShape
+			if tc.name == "duplicate_key" {
+				code = "E_DUPLICATE_KEY"
+			}
+			if raw, err := CompileSourceToPlist("p15-unproved-dictionary.cherri", tc.source); err == nil || len(raw) != 0 || !strings.Contains(err.Error(), code) {
+				t.Fatalf("unproved Dictionary value emitted bytes=%d error=%v", len(raw), err)
+			}
+			svc := service.NewService(nil)
+			uri := "file:///p15-unproved-dictionary.cherri"
+			svc.OpenDocument(uri, 1, tc.source)
+			got, _ := svc.Analyze(uri)
+			if err := p15OptionalDictionaryBoundaryError(got, tc); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
