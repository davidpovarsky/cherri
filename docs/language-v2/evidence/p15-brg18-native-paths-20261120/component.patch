+func p15BRG18Decode(t *testing.T, raw []byte) map[string]any {
+	t.Helper()
+	var actual map[string]any
+	if _, err := plist.Unmarshal(raw, &actual); err != nil {
+		t.Fatal(err)
+	}
+	return actual
+}
