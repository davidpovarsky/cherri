+                with self.subTest(policy="nonprotected_committed_change"):
+                    (root / "outside-v2-protected-scope.txt").write_text("synthetic unrelated change\n")
+                    git("add", "--", "outside-v2-protected-scope.txt")
+                    git("commit", "-m", "R23 synthetic unrelated continuation")
+                    guard("PASS")
+                    git("reset", "--hard", pristine)
+
+                with self.subTest(policy="actual_gate_cli_rejects_draft"):
+                    record = copy.deepcopy(approved)
+                    record["proposalOnly"] = True
+                    write_policy(record)
+                    launcher = (
+                        "import importlib.util,json,pathlib,sys\n"
+                        "spec=importlib.util.spec_from_file_location('r23_fixture_cli',sys.argv[1])\n"
+                        "module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)\n"
+                        "module.REPO_ROOT=pathlib.Path(sys.argv[2])\n"
+                        "module.GATE_DEFINITIONS['R23']=json.loads(sys.argv[3])\n"
+                        "sys.argv=[sys.argv[1],'--gate','R23']\n"
+                        "module.main()\n"
+                    )
+                    child = subprocess.run(
+                        [sys.executable, "-c", launcher, str(gates.__file__), str(root),
+                         json.dumps(guard_definition)], cwd=root, capture_output=True,
+                        text=True, encoding="utf-8", timeout=30)
+                    self.assertEqual(child.returncode, 1, (child.stdout, child.stderr))
+                    self.assertEqual(json.loads(child.stdout)["status"], "FAIL")
+                    write_policy(approved)
+                self.assertEqual(git("status", "--porcelain"), "")
         self.assertEqual(gates.GATE_DEFINITIONS["R23"], production_definition)
 
     def test_c5_07_non_ancestor_source_commit_fails_closed(self):
