     return versions
 
+
+
+def execute_gate(gate_id, defn):
+    """Apply the one pinned R23 v2 policy before the existing Git evaluator."""
+    if gate_id != "R23":
+        return _execute_gate_observation(gate_id, defn)
+    started = time.monotonic()
+    def require(condition, message):
+        if not condition:
+            raise ValueError(message)
+    def unique_object(pairs):
+        obj = {}
+        for key, value in pairs:
+            require(key not in obj, "duplicate policy key")
+            obj[key] = value
+        return obj
+    def git_bytes(*args):
+        result = subprocess.run(["git", "--no-replace-objects", *args], cwd=REPO_ROOT,
+                                capture_output=True, timeout=10)
+        require(result.returncode == 0, "required Git observation failed")
+        return result.stdout
+    result = None
+    try:
+        routing = [name for name in (
+            "GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR",
+            "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES",
+            "GIT_REPLACE_REF_BASE", "GIT_NAMESPACE", "GIT_CONFIG_PARAMETERS", "GIT_CONFIG_COUNT",
+            "GIT_GRAFT_FILE",
+        ) if name in os.environ]
+        require(not routing, "unsupported Git routing override names: " + ",".join(routing))
+        top = git_bytes("rev-parse", "--show-toplevel").decode("utf-8").strip()
+        require(pathlib.Path(top).resolve() == REPO_ROOT.resolve(), "actual Git top-level differs")
+        graft_path = pathlib.Path(git_bytes("rev-parse", "--git-path", "info/grafts").decode("utf-8").strip())
+        if not graft_path.is_absolute():
+            graft_path = REPO_ROOT / graft_path
+        require(not os.path.lexists(graft_path), "legacy Git graft file is unsupported")
+        result = _execute_gate_observation(gate_id, defn)
+        policy_path = REPO_ROOT / defn["policyRecord"]
+        require(policy_path.is_file() and not policy_path.is_symlink(),
+                "pinned R23 policy record is missing or not a regular file")
+        with policy_path.open("rb") as stream:
+            raw = stream.read(65537)
+        require(len(raw) <= 65536 and hashlib.sha256(raw).hexdigest() == defn["policyRecordSha256"],
+                "R23 policy record digest mismatch")
+        policy = json.loads(raw, object_pairs_hook=unique_object)
+        require(policy["schemaVersion"] == 1 and policy["policyVersion"] == 2
+                and policy["policyId"] == "R23_EXACT_PROTECTED_STATE_V2",
+                "unknown R23 policy version")
+        require(policy["baseline"] == defn["upstreamBase"]
+                and policy["previousBaseline"] == "76d722502e20db977e84a095444d0172442655b8",
+                "R23 immutable baseline mismatch")
+        require(policy["proposalOnly"] is False, "draft proposal cannot authorize R23")
+        approval = policy["approval"]
+        require(approval["status"] == "APPROVED"
+                and approval["scope"] == "R23_EXACT_PROTECTED_STATE_V2",
+                "explicit owner R23 policy approval is absent")
+        require(approval["authorRole"] == "PROJECT_OWNER"
+                and isinstance(approval["sourceReference"], str) and approval["sourceReference"].strip()
+                and isinstance(approval["sourceText"], str) and approval["sourceText"].strip(),
+                "owner approval source is incomplete")
+        require(hashlib.sha256(approval["sourceText"].encode("utf-8")).hexdigest()
+                == approval["sourceTextSha256"], "owner approval source digest mismatch")
+        approved_at = datetime.datetime.fromisoformat(approval["approvedAtUtc"].replace("Z", "+00:00"))
+        require(approved_at.utcoffset() == datetime.timedelta(0), "owner approval UTC time missing")
+        contract = REPO_ROOT / policy["originalContract"]["path"]
+        require(policy["originalContract"]["path"] == "docs/apple-runtime/p10/p10r2-acceptance-contract.json"
+                and hashlib.sha256(contract.read_bytes()).hexdigest()
+                == policy["originalContract"]["sha256"], "original R23 contract drift")
+        files = defn["checkProtectedIOSFiles"]
+        states = policy["protectedPaths"]
+        require([entry["path"] for entry in states] == files
+                and files == ["ios/CherriUITests/CherriEditorUITests.swift",
+                              "ios/CherriApp/Views/CodeEditorView.swift"],
+                "protected path inventory changed")
+        def tree(revision):
+            observed = {}
+            for row in git_bytes("ls-tree", "-z", revision, "--", *files).split(b"\0"):
+                if row:
+                    metadata, path = row.split(b"\t", 1)
+                    mode, kind, blob = metadata.decode("ascii").split()
+                    observed[path.decode("utf-8")] = (mode, kind, blob)
+            return observed
+        git_bytes("merge-base", "--is-ancestor", defn["upstreamBase"], "HEAD")
+        baseline, head = tree(defn["upstreamBase"]), tree("HEAD")
+        index = {}
+        for row in git_bytes("ls-files", "--stage", "-z", "--", *files).split(b"\0"):
+            if row:
+                metadata, path = row.split(b"\t", 1)
+                mode, blob, stage = metadata.decode("ascii").split()
+                require(stage == "0" and path.decode("utf-8") not in index,
+                        "protected index is conflicted or duplicated")
+                index[path.decode("utf-8")] = (mode, "blob", blob)
+        for entry in states:
+            relative = entry["path"]
+            path = REPO_ROOT / relative
+            for parent in path.parents:
+                if parent == REPO_ROOT:
+                    break
+                require(not parent.is_symlink(), "protected parent is a symlink")
+            if entry["present"]:
+                expected = (entry["gitMode"], "blob", entry["gitBlob"])
+                require(baseline.get(relative) == head.get(relative) == index.get(relative) == expected,
+                        "protected baseline, HEAD or index identity differs")
+                original = git_bytes("cat-file", "blob", entry["gitBlob"])
+                require(len(original) == entry["bytes"]
+                        and hashlib.sha256(original).hexdigest() == entry["sha256"],
+                        "approved protected blob metadata differs")
+                require(path.is_file() and not path.is_symlink(),
+                        "protected working file is missing or not regular")
+                require(path.stat().st_size == entry["bytes"], "protected working length differs")
+                with path.open("rb") as stream:
+                    working = stream.read(entry["bytes"] + 1)
+                mode = "100755" if path.stat().st_mode & 0o111 else "100644"
+                require(working == original and mode == entry["gitMode"],
+                        "protected working bytes or executable mode differ")
+            else:
+                require(relative not in baseline and relative not in head and relative not in index
+                        and not os.path.lexists(path), "absent protected path was created")
+        result.update({"policyVersion": 2, "policyId": policy["policyId"],
+                       "policyRecordSha256": defn["policyRecordSha256"],
+                       "previousBaseline": policy["previousBaseline"],
+                       "approvedBaseline": policy["baseline"]})
+        result["durationSeconds"] = round(time.monotonic() - started, 3)
+        return result
+    except (OSError, ValueError, TypeError, KeyError, AttributeError, subprocess.SubprocessError) as exc:
+        error = "R23 v2 policy/state rejection: " + str(exc)
+        if result is None:
+            result = {"id": gate_id, "name": defn["name"], "tier": defn["tier"],
+                      "sourceFile": defn["sourceFile"],
+                      "command": "pinned R23 v2 approval and exact protected-state guard",
+                      "outputSha256": hashlib.sha256(error.encode("utf-8")).hexdigest()}
+        result.update({"status": "FAIL", "exitCode": 1, "policyVersion": 2,
+                       "durationSeconds": round(time.monotonic() - started, 3),
+                       "policyOutputSha256": hashlib.sha256(error.encode("utf-8")).hexdigest(),
+                       "error": error})
+        return result
 
 def main():
     parser = argparse.ArgumentParser(description="Cherri P10R4 Executable Release Gate Runner")
