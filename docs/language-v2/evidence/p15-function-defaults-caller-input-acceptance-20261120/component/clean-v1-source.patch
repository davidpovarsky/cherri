+func TestFunctionDefaultEventParserControls(t *testing.T) {
+	for _, id := range []string{"T01", "FN04"} {
+		t.Run(id, func(t *testing.T) {
+			raw := functionDefaultControlEvents(id)
+			if err := parseFunctionDefaultOutput(id, raw); err != nil {
