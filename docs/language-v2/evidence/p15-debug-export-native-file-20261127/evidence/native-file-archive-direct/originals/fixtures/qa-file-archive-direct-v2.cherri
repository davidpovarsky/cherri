// Distinct linear carrier experiment: preserve the complete extracted collection.
let original = text("{\n  \"z\": 1.0, \"a\": 1e0,\n  \"text\": \"שָׁלוֹם 🍒\",\n  \"escaped\": \"\\u05E9\\n\"\n}\n")
let archive = makeArchive(original, ".zip", "cherri-file-probe")
let extracted = extractArchive(archive)
let extractedCount = count(extracted, "Items")
let named = setName(extracted, "cherri-debug.json", false)
let namedCount = count(named, "Items")
let namedType = typeOf(named)
let namedBytes64 = base64Encode(named, lineBreakMode: "None")
let namedStem = getName(named)
let namedExtension = getFileDetail(named, "File Extension")
