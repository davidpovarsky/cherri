          ],
          "default": "next",
          "omissionPolicy": "omit",
          "wireKey": "WFPaginateNextKey",
          "evidenceStatus": "inferred"
        },
        {
          "id": "maxPages",
          "label": "maxPages",
          "displayName": "Maximum native GET invocations (0..100)",
          "type": "Number",
          "rawType": "number",
          "optional": true,
          "literal": true,
          "acceptedForms": [
            "literal"
          ],
          "default": "20",
          "omissionPolicy": "omit",
          "wireKey": "WFPaginateMaxPages",
          "evidenceStatus": "inferred"
        },
        {
          "id": "maxItems",
          "label": "maxItems",
          "displayName": "Maximum returned Dictionary items (0..10000)",
          "type": "Number",
          "rawType": "number",
          "optional": true,
          "literal": true,
          "acceptedForms": [
            "literal"
          ],
          "default": "1000",
