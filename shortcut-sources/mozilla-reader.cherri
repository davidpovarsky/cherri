#define name Mozilla Reader
#define color orange
#define inputs webpage
#define outputs file
#define from sharesheet
#define noinput stopwith "Share a Safari webpage to open Reader View."

#include 'actions/web'
#include 'actions/crypto'
#include 'actions/text'

// Download the official Mozilla Readability source as text.
@readabilityFile = downloadURL("https://cdn.jsdelivr.net/npm/@mozilla/readability@0.6.0/Readability.js")
@readabilitySource = getText(@readabilityFile)

// The wrapper is stored as Base64 only to keep JavaScript quoting/braces away
// from Cherri parsing. Decode it, then explicitly convert the decoded bytes
// back to TEXT before concatenating with Readability.js.
@wrapperB64 = ""
@wrapperBytes = base64Decode(@wrapperB64)
@wrapper = getText(@wrapperBytes)

@javascript = @readabilitySource
@javascript += @wrapper

// The JavaScript ALWAYS completes with Base64-encoded UTF-8 HTML, including
// the error path, so this decode is safe and Quick Look always receives HTML.
@htmlB64 = runJavaScriptOnWebpage(@javascript, ShortcutInput)
@htmlData = base64Decode(@htmlB64)
@file = setName(@htmlData, "Mozilla Reader.html")

quicklook(@file)
