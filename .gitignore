# Binaries for programs and plugins
/cherri
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Tests
*.cherri
!/actions/*.cherri
!/tests/*.cherri
/tests/decomp-me.cherri
*_decompiled.plist
*_processed.cherri
!stdlib.cherri
*.prof

# Development
.DS_Store
/.idea/

# Output
*.shortcut
*.plist
*.xml

# Packages
/packages/

# Local build output
/dist/

# iOS generated output
/.build/ios-cherri-core/
/ios/Cherri.xcodeproj/
/ios/Vendor/
/ios/CherriApp/Resources/PreviewShortcut/
/ios/WebPreview/node_modules/

# Nix
result

# Shortcut corpus: raw inbox data, analysis output, and processing state are
# environment artifacts and must never be committed. Sanitized synthetic
# fixtures under tools/shortcut-corpus/testdata/ are intentional exceptions.
/corpus-inbox/
/analysis/
corpus-state*.json
/catalog.json
/catalog-err.txt
!tools/shortcut-corpus/testdata/**
!tools/shortcut-corpus/testdata/**/*
