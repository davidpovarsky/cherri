// EXTERNAL opt-in Cherri Apple Actions Pack — no modifications to original compiler.
// Existing functions stay original; additional optional parameters use Advanced aliases.
// Source declarations: P10 action DSL. Load original category's enums and metadata.
#include 'actions/math'

// Advanced alias ceilAdvanced for ceil
action 'round' ceilAdvanced(number number: 'WFInput', roundingPlace ?roundTo: 'WFRoundTo' = "Integer", number ?powerOfTen: 'TenToThePowerOf'): number {
	"WFRoundMode": "Always Round Up"
}

// [Doc]: [Rounding] Round Down: Always round a number down to a specified rounding place.

// Advanced alias floorAdvanced for floor
action 'round' floorAdvanced(number number: 'WFInput', roundingPlace ?roundTo: 'WFRoundTo' = "Integer", number ?powerOfTen: 'TenToThePowerOf'): number {
	"WFRoundMode": "Always Round Down"
}

// Advanced alias roundAdvanced for round
action default 'round' roundAdvanced(number number: 'WFInput', roundingPlace ?roundTo: 'WFRoundTo' = "Integer", number ?powerOfTen: 'TenToThePowerOf'): number {
	"WFRoundMode": "Normal"
}

// [Doc]: [Rounding] Round Up: Always round a number up to a specified rounding place.

