#include 'actions/settings'

// Advanced alias setWallpaperAdvanced for setWallpaper
action 'wallpaper.set' setWallpaperAdvanced(
    variable input: 'WFInput',
    variable ?poster: 'WFSelectedPoster',
    text ?location: 'WFWallpaperLocation',
    bool ?legibilityBlur: 'WFWallpaperLegibilityBlur',
    bool ?perspectiveZoom: 'WFWallpaperPerspectiveZoom',
    bool ?showPreview: 'WFWallpaperShowPreview',
    bool ?smartCrop: 'WFWallpaperSmartCrop'
)

