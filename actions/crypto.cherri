/*
Cryptography Actions
*/

// lineBreakMode is a pass-through string: only 'None' has been observed in real
// exports; 'Every 64 Characters' and 'Every 76 Characters' are corroborated but
// the full value domain is unverified. The same applies to base64Decode below.
// [Doc]: Base 64 Encode: Base 64 encodes input.
action default 'base64encode' base64Encode(variable encodeInput: 'WFInput', text ?lineBreakMode: 'WFBase64LineBreakMode'): text {
	"input": "Encode"
}

// [Doc]: Base 64 Decode: Base 64 decodes input.
action 'base64encode' base64Decode(variable input: 'WFInput', text ?lineBreakMode: 'WFBase64LineBreakMode'): variable {
	"WFEncodeMode": "Decode"
}

enum hashType {
	'MD5',
	'SHA1',
	'SHA256',
	'SHA512',
}

// [Doc]: Hash: Generate a hash of type using input.
action hash(variable input: 'WFInput', hashType ?type: 'WFHashType' = "MD5"): text
