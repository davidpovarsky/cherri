// Cherri Language v2 — Share selected ZIP contents, no explicit save actions.
shortcut "ZIP • Share Extracted" {
    from: sharesheet
    inputs: file
}

let icon_swift = ""
let icon_code = ""
let icon_image = ""
let icon_pdf = ""
let icon_document = ""
let icon_video = ""
let icon_audio = ""
let icon_archive = ""
let icon_folder = ""
let icon_file = ""

// The built-in Extract Archive returns temporary content items / folders.
let items = extractArchive(ShortcutInput)
let total = count(items)
if total == 0 {
    alert("This archive contains no files.", title: "Empty ZIP")
} else if total == 1 {
    // Direct share; no picker when the archive contains one top-level item.
    share(items)
} else {
    var allVcards = ""
    var itemIndex = 0
    for file in items {
        itemIndex += 1
        let fileName = getText(getName(file))
        let safeName1 = replaceText(";", r"\;", fileName)
        let safeName2 = replaceText(",", r"\,", safeName1)
        let safeName = replaceText(r"[\r\n]", " ", safeName2, regExp: true)
        let ext = lowercase(getText(getFileDetail(file, detail: "File Extension")))
        let itemType = getText(typeOf(file))
        var kind = "File"
        var iconB64 = icon_file
        if count(matchText(r"^(swift|swiftpm|playground|playgroundbook)$", ext)) > 0 {
            kind = "Swift / Playground"
            iconB64 = icon_swift
        } else if count(matchText(r"(?i)^(folder|directory)$", itemType)) > 0 {
            kind = "Folder"
            iconB64 = icon_folder
        } else if count(matchText(r"^(png|jpg|jpeg|heic|gif|webp|svg)$", ext)) > 0 {
            kind = "Image"
            iconB64 = icon_image
        } else if ext == "pdf" {
            kind = "PDF"
            iconB64 = icon_pdf
        } else if count(matchText(r"^(txt|md|rtf|docx|json|csv|yaml|yml|xml)$", ext)) > 0 {
            kind = "Document / Data"
            iconB64 = icon_document
        } else if count(matchText(r"^(py|js|ts|jsx|tsx|html|css|sh|go)$", ext)) > 0 {
            kind = "Source code"
            iconB64 = icon_code
        } else if count(matchText(r"^(mp4|mov|m4v|avi|mkv)$", ext)) > 0 {
            kind = "Video"
            iconB64 = icon_video
        } else if count(matchText(r"^(mp3|m4a|wav|aac|flac)$", ext)) > 0 {
            kind = "Audio"
            iconB64 = icon_audio
        } else if count(matchText(r"^(zip|7z|rar|tar|gz)$", ext)) > 0 {
            kind = "Archive"
            iconB64 = icon_archive
        }
        // Store the original 1-based index in the hidden vCard job title field.
        // No filename lookup is needed: duplicate filenames stay unambiguous.
        let oneCard = f"BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=UTF-8:{safeName};;;;\nFN;CHARSET=UTF-8:{safeName}\nORG;CHARSET=UTF-8:{kind}\nTITLE:{itemIndex}\nPHOTO;BASE64:{iconB64}\nEND:VCARD\n"
        allVcards = f"{allVcards}{oneCard}"
    }
    // A synthetic temporary .vcf content item, not a saved Contact.
    let menuFile = setName(allVcards, name: "ZIP Menu.vcf")
    let options = getContacts(menuFile)
    let selection = chooseFromList(options, prompt: "Which extracted item should I share?")
    let itemNumber = getNumbers(getContactDetail(selection, detail: "Job Title"))
    let chosenFile = getListItem(items, index: itemNumber)
    share(chosenFile)
}
