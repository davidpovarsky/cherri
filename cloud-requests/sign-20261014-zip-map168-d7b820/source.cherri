// ZIP > hierarchical vCard navigator. Exact native file objects are shared.
// Data-driven extension categorization and Base64 icons: two dictionary actions.
shortcut "ZIP • Browse & Share" {
    from: sharesheet
    inputs: file
}

let fileKinds = {
    "swift": "code",
    "py": "code",
    "js": "code",
    "ts": "code",
    "jsx": "code",
    "tsx": "code",
    "html": "code",
    "css": "code",
    "sh": "code",
    "go": "code",
    "c": "code",
    "h": "code",
    "cpp": "code",
    "hpp": "code",
    "java": "code",
    "kt": "code",
    "rs": "code",
    "rb": "code",
    "php": "code",
    "sql": "code",
    "jsonl": "code",
    "swiftpm": "playground",
    "playground": "playground",
    "playgroundbook": "playground",
    "xcodeproj": "folder",
    "xcworkspace": "folder",
    "xcassets": "folder",
    "bundle": "folder",
    "framework": "folder",
    "app": "folder",
    "rtfd": "folder",
    "jpg": "image",
    "jpeg": "image",
    "png": "image",
    "gif": "image",
    "heic": "image",
    "webp": "image",
    "svg": "image",
    "tiff": "image",
    "tif": "image",
    "bmp": "image",
    "avif": "image",
    "ico": "image",
    "pdf": "pdf",
    "txt": "document",
    "md": "document",
    "rtf": "document",
    "doc": "document",
    "docx": "document",
    "csv": "document",
    "tsv": "document",
    "json": "document",
    "yaml": "document",
    "yml": "document",
    "xml": "document",
    "plist": "document",
    "pages": "document",
    "numbers": "document",
    "epub": "document",
    "log": "document",
    "ini": "document",
    "toml": "document",
    "mp4": "video",
    "mov": "video",
    "m4v": "video",
    "avi": "video",
    "mkv": "video",
    "webm": "video",
    "mp3": "audio",
    "m4a": "audio",
    "wav": "audio",
    "aac": "audio",
    "flac": "audio",
    "ogg": "audio",
    "aiff": "audio",
    "zip": "archive",
    "7z": "archive",
    "rar": "archive",
    "tar": "archive",
    "gz": "archive",
    "bz2": "archive",
    "xz": "archive",
    "tgz": "archive"
}

let kindIcons = {
    "folder": "",
    "file": "",
    "playground": "",
    "code": "",
    "image": "",
    "pdf": "",
    "document": "",
    "video": "",
    "audio": "",
    "archive": ""
}


// The extracted objects stay as native Shortcuts file/folder content items.
// Only the numeric path is rebuilt when moving up/down.
let rootItems = extractArchive(ShortcutInput)
if count(rootItems) == 0 {
    alert("The ZIP is empty.", title: "ZIP Navigator")
    stop()
}
var route = ""
if count(rootItems) == 1 {
    let first = getFirstItem(rootItems)
    let firstExt = lowercase(getText(getFileDetail(first, detail: "File Extension")))
    let firstKind = getText(getValue(fileKinds, key: firstExt))
    let firstType = lowercase(getText(typeOf(first)))
    // A proven folder or a Playgrounds package: enter immediately.
    // An extensionless plain file: display a choice with Direct Share.
    let folderEvidence = count(matchText(r"folder|directory|playground", f"{firstKind}|{firstType}"))
    if folderEvidence > 0 {
        route = "1"
    } else if firstExt != "" {
        share(first)
        stop()
    }
}

// One native Repeat loop handles all folder depths without extra Shortcuts.
repeat 96 as navigationStep {
    var entries = rootItems
    var currentFolder = ShortcutInput
    var currentPath = "ZIP"
    if route != "" {
        let segments = matchText(r"[0-9]+", route)
        for segment in segments {
            let position = getNumbers(getText(segment))
            currentFolder = getListItem(entries, index: position)
            currentPath = f"{currentPath} / {getText(getName(currentFolder))}"
            entries = getFolderContents(currentFolder, recursive: false)
        }
    }

    var cards = ""
    if route != "" {
        cards = f"BEGIN:VCARD\nVERSION:3.0\nN:⬅ Go up;;;;\nFN:⬅ Go up\nORG:Folder navigation\nTITLE:0\nPHOTO;BASE64:{getText(getValue(kindIcons, key: "folder"))}\nEND:VCARD\nBEGIN:VCARD\nVERSION:3.0\nN:↗ Share this folder;;;;\nFN:↗ Share this folder\nORG:Share folder\nTITLE:900000\nPHOTO;BASE64:{getText(getValue(kindIcons, key: "folder"))}\nEND:VCARD\n"
    }

    var position = 0
    for item in entries {
        position += 1
        let fileName = getText(getName(item))
        let safe1 = replaceText(";", r"\;", fileName)
        let safe2 = replaceText(",", r"\,", safe1)
        let safeName = replaceText(r"[\r\n]", " ", safe2, regExp: true)
        let ext = lowercase(getText(getFileDetail(item, detail: "File Extension")))
        var kind = getText(getValue(fileKinds, key: ext))
        if kind == "" {
            kind = "file"
        }
        let nativeType = lowercase(getText(typeOf(item)))
        let detectedFolder = count(matchText(r"folder|directory", nativeType))
        let folderHint = count(matchText(r"\(\)|folder|directory", f"({ext})|{nativeType}"))
        if folderHint > 0 {
            // Preserve Swift's unique icon and package identity.
            if kind != "playground" {
                kind = "folder"
            }
        }
        let iconData = getText(getValue(kindIcons, key: kind))

        let vcard = f"BEGIN:VCARD\nVERSION:3.0\nN:{safeName};;;;\nFN:{safeName}\nORG:{kind}\nTITLE:{position}\nPHOTO;BASE64:{iconData}\nEND:VCARD\n"
        cards = f"{cards}{vcard}"

        // A file without an extension can resemble a folder on iOS.
        // Offer an explicit direct-share entry without discarding the object.
        if ext == "" && detectedFolder == 0 {
            let directShareID = position + 100000
            let alternative = f"BEGIN:VCARD\nVERSION:3.0\nN:↗ Share {safeName};;;;\nFN:↗ Share {safeName}\nORG:Extensionless file\nTITLE:{directShareID}\nPHOTO;BASE64:{getText(getValue(kindIcons, key: "file"))}\nEND:VCARD\n"
            cards = f"{cards}{alternative}"
        }
    }

    let vcFile = setName(cards, name: "ZIP Navigator.vcf")
    let contacts = getContacts(vcFile)
    let selection = chooseFromList(contacts, prompt: currentPath)
    let selectedID = getNumbers(getContactDetail(selection, detail: "Job Title"))

    if selectedID == 0 {
        route = replaceText(r"(\.[0-9]+|^[0-9]+)$", "", route, regExp: true)
    } else if selectedID == 900000 {
        share(currentFolder)
        stop()
    } else if selectedID > 100000 {
        share(getListItem(entries, index: selectedID - 100000))
        stop()
    } else {
        let chosenFile = getListItem(entries, index: selectedID)
        let chosenKind = getText(getContactDetail(selection, detail: "Company"))
        if count(matchText(r"^(folder|playground)$", chosenKind)) > 0 {
            if route == "" {
                route = f"{selectedID}"
            } else {
                route = f"{route}.{selectedID}"
            }
        } else {
            share(chosenFile)
            stop()
        }
    }
}
alert("Navigation limit reached.", title: "ZIP Navigator")
