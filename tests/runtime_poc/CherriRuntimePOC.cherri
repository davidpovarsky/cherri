var myVar = "initial"
myVar = "updated"

var condResult = "false"
if 10 > 5 {
    condResult = "true"
}

var loopTrace = ""
for (outerIndex, outer) in ["A", "B"] {
    for (innerIndex, inner) in ["1", "2"] {
        loopTrace = f"{loopTrace}{outerIndex}:{outer}:{innerIndex}:{inner}|"
    }
}

function multiply(value: Number, factor: Number = 2) -> Number {
    return value * factor
}
let fnResult = multiply(7, factor: 3)

let enc = base64Encode("CHERRI")

let result = f"CHERRI_IOS27_RUNTIME_OK\nVAR={myVar}\nIF={condResult}\nLOOPS={loopTrace}\nFUNCTION={fnResult}\nBASE64={enc}"
setClipboard(result)
