let varMarker = "V2_VAR_OK"

var ifMarker = "V2_IF_FAIL"
if 10 > 5 {
    ifMarker = "V2_IF_OK"
}

var loopMarker = "V2_LOOP_FAIL"
repeat 2 {
    repeat 2 {
        loopMarker = "V2_NESTED_LOOP_OK"
    }
}

function computeFnMarker(tag: Text) -> Text {
    return f"V2_FUNCTION_{tag}"
}
let fnMarker = computeFnMarker("OK")

let variantMarker = "V2_VARIANT_OK"
let enc = base64Encode("CHERRI")

let result = f"CHERRI_IOS27_RUNTIME_OK\n{varMarker}\n{ifMarker}\n{loopMarker}\n{fnMarker}\n{variantMarker}"
setClipboard(result)

