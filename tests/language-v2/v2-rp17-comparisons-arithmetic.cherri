let two = number(2)
let three = number(3)
let five = number(5)
let ten = number(10)
let greater = two > three
let equal = two == two
let unequal = two != two
let divided = five / two
let remainder = ten % three
let mixed = -(five / two) + (three * (two + 1))
return f"gt={greater};eq={equal};ne={unequal};div={divided};mod={remainder};mixed={mixed}"
