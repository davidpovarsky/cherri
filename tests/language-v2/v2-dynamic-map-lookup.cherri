shortcut "Cherri P9 Cloud Runtime Proof" {
    mac: false
}
let data = {"alpha": "EXPECTED_DYNAMIC_VALUE", "beta": "OTHER_VALUE"}
let selectedKey = "alpha"
let actual = data[selectedKey]
if actual == "EXPECTED_DYNAMIC_VALUE" {
    setClipboard("CHERRI_P9_DYNAMIC_KEY_PASS")
    show("CHERRI_P9_DYNAMIC_KEY_PASS")
} else {
    setClipboard("CHERRI_P9_DYNAMIC_KEY_FAIL")
    show("CHERRI_P9_DYNAMIC_KEY_FAIL")
}
